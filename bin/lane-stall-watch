#!/usr/bin/env python3
"""lane-stall-watch — flag teammate lanes that died without saying so.

  lane-stall-watch [--once] [--poll SECONDS] <subagents-dir> [lane ...]
  lane-stall-watch --selftest

An in-process teammate that dies keeps reading "running" or "idle" in ListAgents.
This reads each lane's transcript tail (<subagents-dir>/agent-a<lane>-*.jsonl, or
every transcript written in the last 6 h when no lane is named) and prints one
line per state change:

  STALLED_TOOL   the last event is a tool call whose result is overdue: a Bash call
                 past its declared timeout (default 120 s) plus 3 min, a background
                 Bash call or another tool past 5 min, an Agent call past 90 min. The
                 harness returns every call by its timeout, so an overdue one never ran.
  STALLED_MODEL  the last event is a tool result, prompt or in-flight api-request,
                 and nothing followed for 12 min (an API 529/overload death)
  IDLE           the lane ended its turn and waits for a message (an inbox write
                 does not wake it; TaskStop + SendMessage does)
  UNREAD         the lane is busy, but a message sent after the last one it received
                 has sat unread in its inbox for 10 min: a busy lane reads its inbox only
                 when its turn ends (TaskStop, then one SendMessage that restates them)
  IDLE_UNREAD    the lane is idle and a message sent after the last one it received has
                 sat unread for 2 min: it landed after the lane's turn ended and will never
                 be delivered (TaskStop, then one SendMessage that restates it)

The inbox read is the newest ~/.claude/teams/*/inboxes/<lane>.json. The team directory
is named for the session that created the team, which need not be the session whose
transcript directory holds the lane.

Run it as a Monitor when dispatching teammates. --once prints every lane that is
not BUSY and exits. Evidence: on 2026-10-26 three genomics lanes sat dead or
unread for 84, 43 and 12 min before anyone looked; on 2026-10-31 vcep-l80 ran one
3 h turn while six parent messages (02:49-05:13 JST) never reached it; on 2026-11-02
a 15:14 ruling sat unread for two hours (the lane asked again at 16:52), and a message
that reached eh-pstop-science 16 s after it went idle was never delivered. The watcher
missed both: it read session-e5c8db34's stale inbox while the lanes' team was
session-1e6b2b97, and it checked unread messages only for busy lanes.
"""

from __future__ import annotations

import json
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

BASH_DEFAULT_TIMEOUT = timedelta(seconds=120)
BASH_GRACE = timedelta(minutes=3)
QUICK_TOOL_BUDGET = timedelta(minutes=5)
AGENT_BUDGET = timedelta(minutes=90)
MODEL_GRACE = timedelta(minutes=12)
UNREAD_GRACE = timedelta(minutes=10)
IDLE_UNREAD_GRACE = timedelta(minutes=2)
RECENT = timedelta(hours=6)
TAIL_BYTES = 400_000
TEAMS = Path.home() / ".claude" / "teams"


def parse_stamp(stamp: str) -> datetime:
    return datetime.fromisoformat(stamp.replace("Z", "+00:00"))


def tool_budget(call: dict) -> timedelta:
    """How long the harness may take to return this call's result."""
    name, arguments = call.get("name"), call.get("input") or {}
    if name == "Bash":
        if arguments.get("run_in_background"):
            return QUICK_TOOL_BUDGET
        timeout_ms = arguments.get("timeout")
        timeout = timedelta(milliseconds=timeout_ms) if timeout_ms else BASH_DEFAULT_TIMEOUT
        return timeout + BASH_GRACE
    if name in ("Agent", "Task"):
        return AGENT_BUDGET
    return QUICK_TOOL_BUDGET


def classify(rows: list[dict], now: datetime) -> str:
    if not rows:
        return "BUSY"
    last = rows[-1]
    age = now - parse_stamp(last["timestamp"])
    kind = last.get("type")
    message = last.get("message") or {}
    if kind == "assistant":
        if message.get("stop_reason") == "end_turn":
            return "IDLE"
        content = message.get("content") or []
        calls = [block for block in content if isinstance(block, dict) and block.get("type") == "tool_use"]
        if calls and age > max(tool_budget(call) for call in calls):
            return "STALLED_TOOL"
        return "BUSY"
    if kind in ("user", "api-request") and age > MODEL_GRACE:
        return "STALLED_MODEL"
    return "BUSY"


def tail_rows(path: Path) -> list[dict]:
    with path.open("rb") as handle:
        handle.seek(0, 2)
        handle.seek(max(0, handle.tell() - TAIL_BYTES))
        lines = handle.read().decode("utf-8", "replace").splitlines()
    rows = []
    for line in lines:
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if row.get("timestamp") and row.get("type") in ("assistant", "user", "api-request"):
            rows.append(row)
    return rows


def received(row: dict) -> bool:
    """A message the lane was handed: a prompt row opening with <teammate-message, not a tool result."""
    if row.get("type") != "user":
        return False
    content = (row.get("message") or {}).get("content")
    if isinstance(content, str):
        return content.lstrip().startswith("<teammate-message")
    return any(
        isinstance(block, dict)
        and block.get("type") == "text"
        and str(block.get("text", "")).lstrip().startswith("<teammate-message")
        for block in content or []
    )


def last_received(path: Path, rows: list[dict]) -> datetime | None:
    stamps = [parse_stamp(row["timestamp"]) for row in rows if received(row)]
    if stamps:
        return max(stamps)
    latest = None
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            if "<teammate-message" not in line:
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if row.get("timestamp") and received(row):
                latest = parse_stamp(row["timestamp"])
    return latest


def inbox_rows(lane: str, teams: Path = TEAMS) -> list[dict]:
    """The lane's inbox: the most recently written ~/.claude/teams/*/inboxes/<lane>.json.

    A send writes the inbox, so the live team's copy is the newest; a stale team directory
    can still hold an older inbox under the same lane name.
    """
    candidates = sorted(teams.glob(f"*/inboxes/{lane}.json"), key=lambda item: item.stat().st_mtime)
    if not candidates:
        return []
    try:
        rows = json.loads(candidates[-1].read_text())
    except (OSError, json.JSONDecodeError):
        return []
    return rows if isinstance(rows, list) else []


def overdue_unread(
    inbox: list[dict], floor: datetime | None, now: datetime, grace: timedelta = UNREAD_GRACE
) -> list[datetime]:
    """Unread messages past the grace that were sent after the last one the lane received.

    A TaskStop plus a resume message leaves the queued messages unread for good, so a message
    older than the last received one counts as superseded.
    """
    stamps = []
    for item in inbox:
        if item.get("read") or not item.get("timestamp"):
            continue
        stamp = parse_stamp(item["timestamp"])
        if (floor is None or stamp > floor) and now - stamp > grace:
            stamps.append(stamp)
    return sorted(stamps)


def lane_spellings(agent: str) -> set[str]:
    """The names one transcript answers to: its lane name, and its agent id with and without the leading "a"
    (SendMessage's pin id is "a<lane>-<hex>"; the transcript file is agent-a<lane>-<hex>.jsonl)."""
    return {agent.rsplit("-", 1)[0], agent, f"a{agent}"}


def unmatched_lanes(directory: Path, lanes: list[str]) -> list[str]:
    """Named lanes with no transcript: a watcher over them would stay silent forever (11-13: four agent-id
    arguments matched nothing and the watch printed nothing)."""
    spellings: set[str] = set()
    for path in directory.glob("agent-a*.jsonl"):
        spellings |= lane_spellings(path.stem.removeprefix("agent-a"))
    return [lane for lane in lanes if lane not in spellings]


def lane_transcripts(directory: Path, lanes: list[str], now: datetime) -> dict[str, Path]:
    found: dict[str, Path] = {}
    for path in sorted(directory.glob("agent-a*.jsonl"), key=lambda item: item.stat().st_mtime):
        agent = path.stem.removeprefix("agent-a")
        lane = agent.rsplit("-", 1)[0]
        if lanes and not lane_spellings(agent) & set(lanes):
            continue
        if not lanes and now - datetime.fromtimestamp(path.stat().st_mtime, timezone.utc) > RECENT:
            continue
        found[lane] = path
    return found


def selftest() -> None:
    now = datetime(2026, 10, 26, 15, 0, tzinfo=timezone.utc)
    old = "2026-10-26T14:40:00Z"
    def call(minutes_ago: int, name: str = "Bash", **arguments: object) -> dict:
        moment = (now - timedelta(minutes=minutes_ago)).isoformat()
        block = {"type": "tool_use", "name": name, "input": arguments}
        return {"type": "assistant", "timestamp": moment,
                "message": {"stop_reason": "tool_use", "content": [block]}}

    assert classify([call(6)], now) == "STALLED_TOOL"  # default 120 s + 3 min grace
    assert classify([call(4)], now) == "BUSY"
    assert classify([call(9, timeout=540_000)], now) == "BUSY"  # inside its own timeout
    assert classify([call(13, timeout=540_000)], now) == "STALLED_TOOL"
    assert classify([call(6, run_in_background=True)], now) == "STALLED_TOOL"
    assert classify([call(6, name="Read")], now) == "STALLED_TOOL"
    assert classify([call(60, name="Agent")], now) == "BUSY"
    assert classify([{"type": "user", "timestamp": old, "message": {}}], now) == "STALLED_MODEL"
    assert classify([{"type": "api-request", "timestamp": old}], now) == "STALLED_MODEL"
    assert classify([{"type": "api-request", "timestamp": "2026-10-26T14:55:00Z"}], now) == "BUSY"
    ended = {"type": "assistant", "timestamp": old, "message": {"stop_reason": "end_turn"}}
    assert classify([ended], now) == "IDLE"

    prompt = {"type": "user", "timestamp": old,
              "message": {"content": '<teammate-message teammate_id="team-lead">go</teammate-message>'}}
    tool_output = {"type": "user", "timestamp": old, "message": {"content": [
        {"type": "tool_result", "content": "<teammate-message teammate_id=x>"}]}}
    assert received(prompt) and not received(tool_output)
    def message(minutes_ago: int, read: bool = False) -> dict:
        return {"timestamp": (now - timedelta(minutes=minutes_ago)).isoformat(), "read": read}
    assert len(overdue_unread([message(3)], None, now, IDLE_UNREAD_GRACE)) == 1  # idle: 2 min
    assert overdue_unread([message(1)], None, now, IDLE_UNREAD_GRACE) == []
    import os
    import tempfile
    with tempfile.TemporaryDirectory() as scratch:
        teams = Path(scratch)
        for team, stamp, rows in (("session-old", 1_000, [{"read": True}]),
                                  ("session-new", 2_000, [{"read": False}])):
            inbox = teams / team / "inboxes" / "lane.json"
            inbox.parent.mkdir(parents=True)
            inbox.write_text(json.dumps(rows))
            os.utime(inbox, (stamp, stamp))
        assert inbox_rows("lane", teams) == [{"read": False}]  # the newest team's inbox
        assert inbox_rows("absent", teams) == []
        transcripts = teams / "subagents"
        transcripts.mkdir()
        (transcripts / "agent-afoo-bar-0123abcd.jsonl").write_text("")
        for spelling in ("foo-bar", "foo-bar-0123abcd", "afoo-bar-0123abcd"):
            assert list(lane_transcripts(transcripts, [spelling], now)) == ["foo-bar"], spelling
        assert unmatched_lanes(transcripts, ["foo-bar", "afoo-bar-0123abcd", "baz"]) == ["baz"]
        assert main([str(transcripts), "--once", "baz"]) == 2  # fails loud, never watches nothing
    assert len(overdue_unread([message(15)], None, now)) == 1
    assert overdue_unread([message(15, read=True)], None, now) == []
    assert overdue_unread([message(5)], None, now) == []  # inside the grace
    assert overdue_unread([message(30)], parse_stamp(old), now) == []  # superseded by a later prompt
    assert len(overdue_unread([message(15)], parse_stamp(old), now)) == 1
    print("PASS selftest")


def main(argv: list[str]) -> int:
    if argv[:1] == ["--selftest"]:
        selftest()
        return 0
    once, poll, positional = False, 60, []
    arguments = iter(argv)
    for argument in arguments:
        if argument == "--once":
            once = True
        elif argument == "--poll":
            poll = int(next(arguments))
        else:
            positional.append(argument)
    if not positional:
        print(__doc__, file=sys.stderr)
        return 2
    directory, lanes = Path(positional[0]).expanduser(), positional[1:]
    if not directory.is_dir():
        print(f"lane-stall-watch: no such directory {directory}", file=sys.stderr)
        return 2
    missing = unmatched_lanes(directory, lanes)
    if missing:
        print(f"lane-stall-watch: no transcript agent-a<lane>-<id>.jsonl in {directory} for {', '.join(missing)}; "
              "name a lane by its name or agent id", file=sys.stderr)
        return 2
    previous: dict[str, str] = {}
    while True:
        now = datetime.now(timezone.utc)
        for lane, path in lane_transcripts(directory, lanes, now).items():
            rows = tail_rows(path)
            state, detail = classify(rows, now), ""
            if state in ("BUSY", "IDLE"):
                inbox = inbox_rows(lane)
                grace = UNREAD_GRACE if state == "BUSY" else IDLE_UNREAD_GRACE
                floor = last_received(path, rows)
                overdue = overdue_unread(inbox, floor, now, grace) if inbox else []
                if overdue:
                    oldest = int((now - overdue[0]).total_seconds() // 60)
                    label = "UNREAD" if state == "BUSY" else "IDLE_UNREAD"
                    state, detail = label, f" ({len(overdue)} queued, oldest {oldest} min)"
            if previous.get(lane, "BUSY") != state:
                stamp = datetime.now().strftime("%H:%M")
                print(f"{stamp} {lane}: {previous.get(lane, 'BUSY')} -> {state}{detail}", flush=True)
            previous[lane] = state
        if once:
            return 0
        time.sleep(poll)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
