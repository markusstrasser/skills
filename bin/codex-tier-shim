#!/bin/sh
# codex-tier-shim: installed as ~/.local/bin/codex, ahead of Homebrew's on PATH. A headless `codex exec` runs at the
# Standard tier unless the command itself names another: config.toml's service_tier is shared with the Desktop app's
# speed setting, and on 2026-11-04 the Ultrafast value there (6x Standard) spent the $500 API credit through agents'
# headless runs and very likely most of the plan's week. A command line naming any other tier is refused (exit 2)
# unless CODEX_TIER_ALLOW holds that tier's name: Markus sets it when he asks for a faster run. On 2026-11-18 an
# agent's own -c 'service_tier="priority"' ran 70 headless runs in 48 h past the old "a later -c wins" rule. Every
# other subcommand (the interactive client, resume, login) passes through untouched. CODEX_REAL names the real
# binary in tests.
# Use the same client build as Desktop when installed. An older standalone
# client can omit newly released models from its subscription catalog.
app_codex='/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex'
if [ -n "${CODEX_REAL:-}" ]; then
  real=$CODEX_REAL
elif [ -x "$app_codex" ]; then
  real=$app_codex
else
  real=/opt/homebrew/bin/codex
fi
[ -x "$real" ] || { echo "codex-tier-shim: no codex at $real" >&2; exit 127; }
skip=
for arg in "$@"; do
  if [ -n "$skip" ]; then skip=; continue; fi
  case "$arg" in
    -c|--config|-m|--model|-p|--profile|-s|--sandbox|-a|--ask-for-approval|-C|--cd|-i|--image|--add-dir) skip=1 ;;
    -*) ;;
    exec|e)
      for a in "$@"; do
        case "$a" in
          *service_tier*)
            tier=$(printf '%s' "$a" | sed -n 's/.*service_tier[^a-z_]*\([a-z_]*\).*/\1/p')
            if [ "$tier" != default ] && [ "$tier" != "${CODEX_TIER_ALLOW:-}" ]; then
              echo "codex-tier-shim: refused service_tier \"$tier\": headless codex runs at Standard; Markus sets" \
                "CODEX_TIER_ALLOW=$tier when he asks for a faster run" >&2
              exit 2
            fi ;;
        esac
      done
      exec "$real" -c 'service_tier="default"' "$@" ;;
    *) break ;;
  esac
done
exec "$real" "$@"
