#!/usr/bin/env bash
# lane — dispatch and supervise headless workers in isolated git worktrees.
set -euo pipefail
# A caller that stops reading early (`lane resume … | head -2`) must not abort a launch half-done: on 2026-10-14
# SIGPIPE killed a resume after it had claimed the note and archived the log, before the worker started. echo only
# ever writes to the terminal or a pipe here (files are written with printf or python), so a failed write is safe to drop.
trap '' PIPE
echo() { builtin echo "$@" 2>/dev/null || true; }
# Children inherit the ignored SIGPIPE, so a closed reader turns their writes into EPIPE, and git's check_pipe then
# exits 141: on 2026-10-26 `lane run … 2>&1 | head -1` killed four launches after `git worktree add` had made their
# branches. A stdout or stderr that is a pipe goes through a relay that keeps draining after its reader goes, so no
# child (git, a prepare hook) ever writes into a closed pipe.
relay() { while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line" 2>/dev/null || :; done; }
if [ -p /dev/stdout ]; then exec 1> >(relay); fi
if [ -p /dev/stderr ]; then exec 2> >(relay >&2); fi

LANE_HOME="${LANE_HOME:-${HOME:?lane: HOME is not set}/.cache/lanes}"
# Worker helpers live beside the real script (~/.local/bin/lane is a symlink to it).
LANE_BIN_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)
DEFAULT_STALL_MIN=20
WORKER_SETTINGS=""

usage() {
  cat >&2 <<'EOF'
usage:
  lane run <name> --repo <path> --brief <file> [--worker codex|claude|opencode] [--no-worktree] [--base <ref>]
           [--keep-checkout] [--seed-patch <patch>] [--seed-file <file>]...
      (a finished lane's checkout is harvested to $LANE_HOME/<name>.harvest/<stamp>/ and removed when the worker
       exits 0, see bin/lane-retire; --keep-checkout keeps it, for a lane you will resume; a failed lane keeps it)
      (a repo that declares a checkout hook, `git config lane.checkout <exe>` or an executable .claude/lane-checkout,
       gets its lanes in $LANE_HOME/checkouts/<name>, built by `<hook> <dest> <base-oid>` and rechecked on reuse by
       `<hook> --verify <dest> <base-oid>`, env LANE_NAME LANE_REPO LANE_BRIEF LANE_SEED_PATCH LANE_SEED_FILES; the
       seeds go only to a new checkout; <dest>/.git/lane-checkout.json may name {"env": {...}} for the worker and
       {"provided": {<path>: <sha256>}} for inputs the hook copied in, which a harvest skips while unchanged)
      (claude worker: LANE_CLAUDE_MODEL=<m> LANE_CLAUDE_EFFORT=<e> env override the default opus/default effort)
      (opencode worker: bin/lane-opencode's default model, DeepSeek V4.1 Flash with thinking on; LANE_OPENCODE_MODEL=<provider/model> overrides it)
      (opencode worker: no sandbox; a scrubbed env and a deny-list guard it, see bin/lane-opencode; exit 86 = balance exhausted)
      (opencode worker: a provider at capacity (429) is retried in the lane's session for ~20 min, then exit 85; lane resume continues it)
      (codex worker: LANE_CODEX_MODEL=<m> LANE_CODEX_EFFORT=<e> env override the default gpt-6-astra/config effort)
      (codex worker: LANE_CODEX_ADD_DIRS=<a:b> adds writable roots; LANE_CODEX_NETWORK=1 enables network; git metadata stays read-only, so the parent merges and commits)
  lane review <name> [--model <m>] [--effort <e>] [--focus <file>] [--report <file>] [--out <file>] [--bg]
  lane ls [--stall-min <minutes>]
      (WAITING: a claude worker sleeping out the api_retry delay it logged, e.g. a usage-limit reset)
  lane stop <name>
  lane resume <name> [--note <file>|--no-note]
      (exported worker settings override recorded settings; all others are retained)
  lane reap <name> [--force]
      (without --force it shows the diff; --force harvests, then removes the checkout; a retired lane loses only its
       metadata and log, never its harvest)
  lane archive [--apply]
      (a dry run unless --apply: a lane whose DONE marker is over 14 days old, with no live process, no
       $LANE_HOME/<name>.KEEP file and no checkout left moves to $LANE_ARCHIVE_VOLUME/lane-archive/ (default
       /Volumes/2TBPNY), each file sha256-checked before its source goes; a bounded pass runs after each successful
       retire; see bin/lane-archive)
  lane unarchive <name>
      (copies an archived lane back, checks every sha256, gives it 14 more days and removes the archive)
EOF
}

die() {
  echo "lane: $*" >&2
  exit 2
}

require_python() {
  command -v python3 >/dev/null 2>&1 || die "python3 is required for lane metadata"
}

init_lane_home() {
  validate_plain_value "LANE_HOME" "$LANE_HOME"
  mkdir -p "$LANE_HOME"
  LANE_HOME=$(cd "$LANE_HOME" && pwd -P)
}

validate_name() {
  case "$1" in
    "" | *[!A-Za-z0-9._-]* | [.-]*) die "name must start with an alphanumeric and contain only A-Z, a-z, 0-9, dot, underscore, or dash" ;;
  esac
}

validate_plain_value() {
  local label="$1"
  local value="$2"
  case "$value" in
    *$'\n'* | *$'\r'* | *$'\t'*) die "$label must not contain tabs or newlines" ;;
  esac
}

absolute_file() {
  local path="$1"
  local label="${2:-brief}"
  local dir
  local base
  [ -f "$path" ] || die "$label does not exist: $path"
  dir=$(cd "$(dirname "$path")" && pwd -P)
  base=$(basename "$path")
  printf '%s/%s\n' "$dir" "$base"
}

metadata_path() {
  printf '%s/%s.json\n' "$LANE_HOME" "$1"
}

log_path() {
  printf '%s/%s.log\n' "$LANE_HOME" "$1"
}

done_path() {
  printf '%s/%s.done\n' "$LANE_HOME" "$1"
}

review_done_path() {
  printf '%s/%s.review.done\n' "$LANE_HOME" "$1"
}

review_pid_path() {
  printf '%s/%s.review.pid\n' "$LANE_HOME" "$1"
}

review_log_path() {
  printf '%s/%s.review.log\n' "$LANE_HOME" "$1"
}

review_lock_path() {
  printf '%s/%s.review.lock\n' "$LANE_HOME" "$1"
}

resolve_worker_settings() {
  local metadata="${1:-}"
  local resolved
  local key
  local value
  require_python
  resolved=$(python3 - "$metadata" <<'PY'
import json
import os
import sys

# Empty effort means no CLI override: use the worker's configured/default effort.
defaults = {
    "codex_model": "gpt-6-astra",
    "codex_effort": "",
    "codex_add_dirs": "",
    "codex_network": "0",
    "claude_model": "opus",
    "claude_effort": "",
    # Empty: bin/lane-opencode's own default applies, so the model is defined once (a copy here overrode it).
    "opencode_model": "",
}
recorded = {}
if sys.argv[1]:
    with open(sys.argv[1], encoding="utf-8") as handle:
        metadata = json.load(handle)
    if "worker_settings" not in metadata:
        print("lane: warning: original worker settings are unknown; using caller environment", file=sys.stderr)
    else:
        recorded = metadata["worker_settings"]
        # A lane recorded before a setting existed resumes with that setting's default.
        if not isinstance(recorded, dict) or any(
            key in recorded and not isinstance(recorded[key], str) for key in defaults
        ):
            sys.exit("lane: invalid recorded worker settings")

settings = {}
for key, default in defaults.items():
    env_key = "LANE_" + key.upper()
    value = os.environ.get(env_key, recorded.get(key, default))
    if any(char in value for char in "\t\r\n"):
        sys.exit(f"lane: {env_key} must not contain tabs or newlines")
    if key.endswith("_model"):
        value = value or default
    elif key == "codex_add_dirs":
        value = ":".join(directory for directory in value.split(":") if directory)
    elif key == "codex_network":
        value = "1" if value == "1" else "0"
    settings[key] = value
    print(f"{env_key}\t{value}")
print("WORKER_SETTINGS\t" + json.dumps(settings, sort_keys=True))
PY
  ) || die "could not resolve worker settings"
  while IFS=$'\t' read -r key value; do
    if [ "$key" = WORKER_SETTINGS ]; then
      WORKER_SETTINGS="$value"
    else
      export "$key=$value"
    fi
  done <<<"$resolved"
}

print_worker_settings() {
  case "$1" in
    claude)
      echo "lane: settings claude_model=$LANE_CLAUDE_MODEL claude_effort=${LANE_CLAUDE_EFFORT:-default}"
      ;;
    opencode)
      echo "lane: settings opencode_model=${LANE_OPENCODE_MODEL:-default}"
      ;;
    *)
      echo "lane: settings codex_model=$LANE_CODEX_MODEL codex_effort=${LANE_CODEX_EFFORT:-config} add_dirs=$LANE_CODEX_ADD_DIRS network=$LANE_CODEX_NETWORK"
      ;;
  esac
}

json_write() {
  local output="$1"
  local tmp="${output}.tmp.$$"
  shift
  require_python
  python3 - "$tmp" "$@" <<'PY'
import json
import os
import sys

(
    output,
    name,
    repo,
    worktree,
    brief,
    pid,
    started_at,
    started_epoch,
    worker,
    base,
    branch,
    no_worktree,
    worker_settings,
    last_note,
    checkout,
    checkout_base,
    keep_checkout,
) = sys.argv[1:]
payload = {
    "name": name,
    "repo": repo,
    "worktree": worktree,
    "brief": brief,
    "pid": int(pid),
    "started_at": started_at,
    "started_epoch": int(started_epoch) if started_epoch else "",
    "worker": worker,
    "base": base,
    "branch": branch,
    "no_worktree": no_worktree == "true",
    "worker_settings": json.loads(worker_settings),
    "last_note": last_note,
    "checkout": checkout,
    "checkout_base": checkout_base,
    "keep_checkout": keep_checkout == "true",
}
with open(output, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, indent=2, sort_keys=True)
    handle.write("\n")
os.chmod(output, 0o600)
PY
  mv "$tmp" "$output"
}

json_get() {
  local input="$1"
  local key="$2"
  require_python
  python3 - "$input" "$key" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    value = json.load(handle)[sys.argv[2]]
if isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
PY
}

# A metadata key, or a default for a lane recorded before the key existed.
json_get_or() {
  local input="$1"
  local key="$2"
  local default="$3"
  require_python
  python3 - "$input" "$key" "$default" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    value = json.load(handle).get(sys.argv[2], sys.argv[3])
if isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
PY
}

checkout_state_path() {
  printf '%s/%s.checkout-state\n' "$LANE_HOME" "$1"
}

hook_checkout_path() {
  printf '%s/checkouts/%s\n' "$LANE_HOME" "$1"
}

# worktree, hook or none; a lane recorded before checkout modes existed is worktree or none.
lane_checkout_mode() {
  local metadata="$1"
  local fallback="worktree"
  [ "$(json_get "$metadata" no_worktree)" = "true" ] && fallback="none"
  json_get_or "$metadata" checkout "$fallback"
}

# The newest harvest lane-retire wrote for a lane (stamps sort by time).
latest_harvest() {
  local dir="$LANE_HOME/$1.harvest"
  local latest=""
  local entry
  for entry in "$dir"/*Z; do
    [ -d "$entry" ] && latest="$entry"
  done
  [ -n "$latest" ] || return 1
  printf '%s\n' "$latest"
}

# A lane without metadata may sit on the SSD (bin/lane-archive): name its archive rather than "unknown".
unknown_lane() {
  local archived
  archived=$("$LANE_BIN_DIR/lane-archive" --home "$LANE_HOME" --where "$1" 2>/dev/null) || die "unknown lane: $1"
  die "$1 was archived to $archived; lane unarchive $1 restores it"
}

# The bounded pass after each successful retire, here and in the worker's exit path: lanes that finished over 14 days
# ago move to the SSD (bin/lane-archive). No timer runs it.
archive_pass() {
  local out
  out=$("$LANE_BIN_DIR/lane-archive" --home "$LANE_HOME" --apply --bounded 2>&1) || true
  [ -n "$out" ] || return 0
  # Under set -e a failed append would turn the reap that just succeeded into a failure.
  printf '%s\n' "$out" >>"$LANE_HOME/.archive.log" || echo "lane: archive pass: could not append to $LANE_HOME/.archive.log" >&2
  echo "lane: archive pass: $(printf '%s\n' "$out" | tail -n 1) (log: $LANE_HOME/.archive.log)"
}

# A repo whose lanes must not see its full tree (genomics withholds donor data from third-party models) declares a
# hook that builds each lane's checkout: `git config lane.checkout <absolute executable>`, else .claude/lane-checkout.
checkout_hook() {
  local repo="$1"
  local hook
  hook=$(git -C "$repo" config --get lane.checkout 2>/dev/null || true)
  if [ -n "$hook" ]; then
    case "$hook" in /*) ;; *) die "lane.checkout in $repo must be an absolute path: $hook" ;; esac
    [ -f "$hook" ] && [ -x "$hook" ] || die "lane.checkout in $repo names $hook, which is not an executable file"
    printf '%s\n' "$hook"
  elif [ -f "$repo/.claude/lane-checkout" ] && [ -x "$repo/.claude/lane-checkout" ]; then
    printf '%s\n' "$repo/.claude/lane-checkout"
  fi
}

run_checkout_hook() {
  local hook="$1"
  local name="$2"
  local repo="$3"
  local brief="$4"
  local note="$5"
  local seed_patch="$6"
  local seed_list="$7"
  shift 7
  env LANE_NAME="$name" LANE_REPO="$repo" LANE_BRIEF="$brief" LANE_NOTE="$note" LANE_SEED_PATCH="$seed_patch" \
    LANE_SEED_FILES="$seed_list" "$hook" "$@" >&2
}

# The hook builds a new checkout (seeded, when seeds are given) or rechecks an existing one with --verify. The
# checkout path comes from the validated lane name, never from the hook, so a partial build is removed by that path.
ensure_hook_checkout() {
  local name="$1"
  local repo="$2"
  local base="$3"
  local hook="$4"
  local brief="$5"
  local seed_patch="$6"
  local seed_list="$7"
  local dest
  local rc
  dest=$(hook_checkout_path "$name")
  if [ -e "$dest" ]; then
    [ -z "$seed_patch" ] && [ -z "$seed_list" ] || die "seeds go only to a new checkout and $dest exists: use a new lane name"
    [ -d "$dest/.git" ] && [ -s "$dest/.git/lane-checkout-base" ] || die "existing path is not a lane checkout: $dest"
    run_checkout_hook "$hook" "$name" "$repo" "$brief" "" "" "" --verify "$dest" "$base" ||
      die "checkout hook $hook refused to reuse $dest (rc=$?)"
  else
    "$LANE_BIN_DIR/disk-floor" --path "$LANE_HOME" --what "lane checkout $dest" \
      --hint "lane ls, then lane reap <finished-lane> --force" || die "disk below the floor; reclaim first"
    mkdir -p "$LANE_HOME/checkouts"
    if run_checkout_hook "$hook" "$name" "$repo" "$brief" "" "$seed_patch" "$seed_list" "$dest" "$base"; then
      rc=0
    else
      rc=$?
    fi
    if [ "$rc" -ne 0 ] || [ ! -d "$dest/.git" ] || ! git -C "$dest" rev-parse --verify --quiet HEAD >/dev/null; then
      if [ -e "$dest" ]; then
        chmod -R u+rwX "$dest" 2>/dev/null || true
        rm -rf -- "$dest"
      fi
      die "checkout hook $hook failed (rc=$rc) or built no git checkout at $dest"
    fi
    # lane-retire tells the lane's own commits from the checkout's by this base; lane owns it, not the hook.
    git -C "$dest" rev-parse HEAD >"$dest/.git/lane-checkout-base"
  fi
  printf '%s\n' "$dest"
}

# K=V lines from <checkout>/.git/lane-checkout.json "env": settings the hook gives every worker (genomics points uv
# at the shared venv and turns sync off, so a lane never rewrites it).
checkout_env_lines() {
  local checkout="$1"
  [ -f "$checkout/.git/lane-checkout.json" ] || return 0
  require_python
  python3 - "$checkout/.git/lane-checkout.json" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    env = json.load(handle).get("env", {})
if not isinstance(env, dict):
    sys.exit("lane: lane-checkout.json env must be an object")
for key, value in sorted(env.items()):
    if not re.fullmatch(r"[A-Z_][A-Z0-9_]*", key) or key.startswith("LANE_") or not isinstance(value, str) \
            or any(char in value for char in "\0\n\r"):
        sys.exit(f"lane: invalid lane-checkout.json env entry {key!r}")
    print(f"{key}={value}")
PY
}

lane_group_is_alive() {
  local pid="$1"
  local started_epoch="${2:-}"
  local current_started_epoch
  case "$pid" in
    "" | *[!0-9]*) return 1 ;;
  esac
  [ "$pid" -gt 1 ] 2>/dev/null || return 1
  kill -0 -- "-$pid" 2>/dev/null || return 1
  if [ -z "$started_epoch" ]; then
    echo "lane: warning: no recorded started_epoch for process group $pid; falling back to pid liveness" >&2
    return 0
  fi
  current_started_epoch=$(process_started_epoch "$pid")
  [ -n "$current_started_epoch" ] && [ "$current_started_epoch" = "$started_epoch" ]
}

process_group_exists() {
  local pid="$1"
  case "$pid" in
    "" | *[!0-9]*) return 1 ;;
  esac
  [ "$pid" -gt 1 ] 2>/dev/null || return 1
  kill -0 -- "-$pid" 2>/dev/null
}

review_process_is_alive() {
  local pid="$1"
  local started_epoch="${2:-}"
  local current_started_epoch
  case "$pid" in
    "" | *[!0-9]*) return 1 ;;
  esac
  [ "$pid" -gt 1 ] 2>/dev/null || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  if [ -z "$started_epoch" ]; then
    echo "lane: warning: no recorded started_epoch for review pid $pid; falling back to pid liveness" >&2
    return 0
  fi
  current_started_epoch=$(process_started_epoch "$pid")
  [ -n "$current_started_epoch" ] && [ "$current_started_epoch" = "$started_epoch" ]
}

process_started_epoch() {
  local pid="$1"
  local lstart
  local epoch
  case "$pid" in
    "" | *[!0-9]*)
      echo ""
      return
      ;;
  esac
  lstart=$(LC_ALL=C ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || true)
  [ -n "$lstart" ] || {
    echo ""
    return
  }
  epoch=$(LC_ALL=C date -j -f '%a %b %e %T %Y' "$lstart" '+%s' 2>/dev/null || true)
  if [ -z "$epoch" ]; then
    epoch=$(LC_ALL=C date -d "$lstart" '+%s' 2>/dev/null || true)
  fi
  case "$epoch" in
    "" | *[!0-9]*) echo "" ;;
    *) echo "$epoch" ;;
  esac
}

wait_for_group_exit() {
  local pid="$1"
  local started_epoch="$2"
  local attempts="$3"
  local count=0
  while lane_group_is_alive "$pid" "$started_epoch" && [ "$count" -lt "$attempts" ]; do
    sleep 0.1
    count=$((count + 1))
  done
  ! lane_group_is_alive "$pid" "$started_epoch"
}

file_mtime() {
  local mtime
  mtime=$(stat -c %Y "$1" 2>/dev/null || true)
  case "$mtime" in
    "" | *[!0-9]*) ;;
    *)
      echo "$mtime"
      return
      ;;
  esac
  stat -f %m "$1"
}

log_age_seconds() {
  local log="$1"
  local now
  local mtime
  [ -e "$log" ] || {
    echo -1
    return
  }
  now=$(date +%s)
  mtime=$(file_mtime "$log")
  echo $((now - mtime))
}

format_age() {
  local seconds="$1"
  if [ "$seconds" -lt 0 ]; then
    echo "-"
  elif [ "$seconds" -lt 60 ]; then
    printf '%ss\n' "$seconds"
  elif [ "$seconds" -lt 3600 ]; then
    printf '%sm\n' "$((seconds / 60))"
  elif [ "$seconds" -lt 86400 ]; then
    printf '%sh\n' "$((seconds / 3600))"
  else
    printf '%sd\n' "$((seconds / 86400))"
  fi
}

# A claude worker waiting out a usage limit logs one stream-json api_retry event, then
# stays quiet for up to the watchdog cap; the event's retry_delay_ms says how long.
retry_wait_covers() {
  local log="$1"
  local age="$2"
  [ -s "$log" ] || return 1
  python3 - "$log" "$age" <<'PY'
import json
import sys

with open(sys.argv[1], "rb") as handle:
    handle.seek(0, 2)
    handle.seek(max(0, handle.tell() - 65536))
    lines = [line for line in handle.read().splitlines() if line.strip()]
try:
    event = json.loads(lines[-1])
    delay_ms = int(event["retry_delay_ms"]) if event.get("subtype") == "api_retry" else 0
except (IndexError, ValueError, KeyError, TypeError, AttributeError):
    delay_ms = 0
sys.exit(0 if int(sys.argv[2]) * 1000 < delay_ms + 300000 else 1)
PY
}

lane_state() {
  local name="$1"
  local pid="$2"
  local started_epoch="$3"
  local stall_min="$4"
  local marker
  local marker_value
  local age
  marker=$(done_path "$name")
  if [ -f "$marker" ]; then
    marker_value=$(sed -n '1s/^EXIT=//p' "$marker")
    case "$marker_value" in
      "" | *[!0-9]*) echo "DONE:?" ;;
      *) echo "DONE:$marker_value" ;;
    esac
    return
  fi
  if lane_group_is_alive "$pid" "$started_epoch"; then
    age=$(log_age_seconds "$(log_path "$name")")
    if [ "$age" -gt $((stall_min * 60)) ] && retry_wait_covers "$(log_path "$name")" "$age"; then
      echo "WAITING"
    elif [ "$age" -gt $((stall_min * 60)) ]; then
      echo "STALLED"
    else
      echo "RUNNING"
    fi
  else
    echo "DEAD"
  fi
}

# One line per lane metadata file, in argument order, fields split by \x1f: name, pid, started_at, started_epoch,
# worktree, and the checkout's `git status --porcelain` line count ("?" when git status fails there). A file that
# lacks a field prints "!" and its path. One process with concurrent git status: five python3 starts and a serial
# git status per lane took `lane ls` to 155 s over 378 lanes (2026-10-25).
ls_rows() {
  require_python
  python3 - "$@" <<'PY'
import concurrent.futures
import json
import os
import subprocess
import sys

SEP = "\x1f"


def text(value):
    return ("true" if value else "false") if isinstance(value, bool) else str(value)


def dirty(worktree):
    if not os.path.isdir(worktree):
        return "?"
    status = subprocess.run(["git", "-C", worktree, "status", "--porcelain"],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return str(status.stdout.count(b"\n")) if status.returncode == 0 else "?"


rows = []
for path in sys.argv[1:]:
    try:
        with open(path, encoding="utf-8") as handle:
            meta = json.load(handle)
        fields = [text(meta[key]) for key in ("name", "pid", "started_at")]
        fields.append(text(meta["started_epoch"]) if "started_epoch" in meta else "")
        fields.append(text(meta["worktree"]))
    except (OSError, ValueError, KeyError, TypeError):
        fields = None
    if fields is None or any(SEP in field or "\n" in field for field in fields):
        fields = ["!", path]
    rows.append(fields)
with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
    counts = pool.map(lambda fields: "" if fields[0] == "!" else dirty(fields[4]), rows)
    for fields, count in zip(rows, counts):
        print(SEP.join(fields if fields[0] == "!" else fields + [count]))
PY
}

# A repo's prepare script may symlink the worktree's project uv cache outside the worktree
# (genomics: pyproject `cache-dir = ".uv-cache"`, linked to main's cache). Codex runs
# commands with shell_environment_policy.inherit = "core", so the UV_CACHE_DIR exported at
# launch never reaches them and uv writes through that symlink. Without the target as a
# writable root, every `uv run` in the lane fails with EPERM (genomics lane-smoke, 2026-10-14).
add_uv_cache_writable_root() {
  local worktree="$1"
  local target
  [ -L "$worktree/.uv-cache" ] || return 0
  if ! target=$(cd "$worktree/.uv-cache" 2>/dev/null && pwd -P); then
    echo "lane: $worktree/.uv-cache is a dangling symlink — uv will fail inside the sandbox" >&2
    return 0
  fi
  case ":$LANE_CODEX_ADD_DIRS:" in
    *":$target:"*) return 0 ;;
  esac
  LANE_CODEX_ADD_DIRS="${LANE_CODEX_ADD_DIRS:+$LANE_CODEX_ADD_DIRS:}$target"
  export LANE_CODEX_ADD_DIRS
}

# Genomics gates heavy commands through scripts/cpu_slot.py, whose flock directory lives outside
# the worktree (~/.cache/genomics/cpu-slots, or GENOMICS_CPU_SLOT_DIR). Without it as a writable
# root the slot cannot lock, admission degrades, and every `cpu_slot.py run --strict` pytest
# exits 75, so the parent had to run all of a lane's tests (genomics P4.7 lane, 2026-10-19).
add_cpu_slot_writable_root() {
  local worktree="$1"
  local directory
  [ -f "$worktree/scripts/cpu_slot.py" ] || return 0
  directory="${GENOMICS_CPU_SLOT_DIR:-$HOME/.cache/genomics/cpu-slots}"
  if ! mkdir -p "$directory" || ! directory=$(cd "$directory" && pwd -P); then
    echo "lane: cannot prepare cpu-slot directory $directory — gated tests will exit 75 in the sandbox" >&2
    return 0
  fi
  case ":$LANE_CODEX_ADD_DIRS:" in
    *":$directory:"*) return 0 ;;
  esac
  LANE_CODEX_ADD_DIRS="${LANE_CODEX_ADD_DIRS:+$LANE_CODEX_ADD_DIRS:}$directory"
  export LANE_CODEX_ADD_DIRS
}

# Per-worktree bootstrap: run the repo's `.agents/prepare` (Delta/agent-skills
# convention; `.claude/prepare` as a local override) inside a freshly created
# worktree. Must be fast, idempotent and non-interactive — a lane never blocks on it.
run_worktree_prepare() {
  local repo="$1"
  local worktree="$2"
  local prep
  for prep in "$repo/.claude/prepare" "$repo/.agents/prepare"; do
    if [ -x "$prep" ]; then
      echo "lane: prepare → $prep (in $worktree)" >&2
      (cd "$worktree" && LANE_REPO="$repo" "$prep") >&2 || echo "lane: prepare exited $? — continuing" >&2
      return 0
    fi
  done
  return 0
}

ensure_worktree() {
  local name="$1"
  local repo="$2"
  local base="$3"
  local no_worktree="$4"
  local worktree
  local branch
  local actual_branch

  if [ "$no_worktree" = "true" ]; then
    printf '%s\t\n' "$repo"
    return
  fi

  worktree="$repo/.claude/worktrees/codex-$name"
  branch="codex/$name"
  if [ -e "$worktree" ]; then
    git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "existing path is not a git worktree: $worktree"
    actual_branch=$(git -C "$worktree" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    [ "$actual_branch" = "$branch" ] || die "existing worktree is on $actual_branch, expected $branch"
  else
    # A new worktree is a full checkout (~600 MB for genomics); below the shared floor refuse it with the reclaim
    # commands instead of letting the lane die on ENOSPC (2026-10-24: 9.8 GiB free).
    "$LANE_BIN_DIR/disk-floor" --path "$repo" --what "lane worktree $worktree" \
      --hint "lane ls, then lane reap <finished-lane> --force" || die "disk below the floor; reclaim first"
    mkdir -p "$(dirname "$worktree")"
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo" worktree add "$worktree" "$branch" >&2
    else
      git -C "$repo" worktree add -b "$branch" "$worktree" "$base" >&2
    fi
    run_worktree_prepare "$repo" "$worktree"
  fi
  printf '%s\t%s\n' "$worktree" "$branch"
}

build_prompt() {
  local worker="$1"
  local brief="$2"
  local resume_note="$3"
  local prompt
  if [ "$worker" = "claude" ]; then
    prompt=$(<"$brief")
  elif [ "$worker" = "opencode" ]; then
    # OpenCode has no sandbox to keep git metadata read-only, so the contract is in the prompt (and in
    # lane-opencode's deny-list).
    prompt="$(<"$brief")

Git state belongs to the parent: edit files and run checks, but do not stage, commit, merge, stash or switch branches. Do not stop or kill processes you did not start. End by listing every path you changed."
  else
    # The Codex sandbox keeps a worktree's git metadata read-only even under --add-dir
    # (2026-10-11: a Sol lane merge died on ORIG_HEAD.lock in .git/worktrees/<lane>).
    # It also denies ps and sysctl: on 2026-10-14 `/usr/bin/time -l` exited 1 after a successful child
    # ("sysctl kern.clockrate: Operation not permitted"), so a worker's timing wrapper failed a passing run.
    prompt="Do the task in $brief.
Git metadata is read-only in this sandbox: edit files and run checks, but do not merge, stage or commit. The parent does that. The sandbox also denies ps and sysctl, so /usr/bin/time -l exits 1 after a successful command: measure time and memory from Python (time.perf_counter, resource.getrusage). End by listing every path you changed."
  fi
  if [ -n "$resume_note" ]; then
    prompt="$(<"$resume_note")

$prompt"
  fi
  printf '%s' "$prompt"
}

print_watch() {
  local name="$1"
  local log="$2"
  local marker="$3"
  local quoted_log
  local quoted_marker
  printf -v quoted_log '%q' "$log"
  printf -v quoted_marker '%q' "$marker"
  echo "watch: while [ ! -f $quoted_marker ]; do sleep 15; done; echo \"$name \$(cat $quoted_marker) tail=\$(tail -1 $quoted_log)\""
}

launch_worker() {
  local name="$1"
  local repo="$2"
  local worktree="$3"
  local brief="$4"
  local worker="$5"
  local base="$6"
  local branch="$7"
  local no_worktree="$8"
  local resume_mode="$9"
  local resume_note="${10}"
  local checkout_mode="${11}"
  local checkout_base="${12}"
  local keep_checkout="${13}"
  local metadata
  local log
  local marker
  local checkout_state
  local env_lines
  local entry
  local checkout_env_names=""
  local -a checkout_env=()
  local prompt
  local started_at
  local started_epoch
  local launch_pid

  metadata=$(metadata_path "$name")
  log=$(log_path "$name")
  marker=$(done_path "$name")
  checkout_state=$(checkout_state_path "$name")
  if [ -f "$metadata" ]; then
    local old_pid
    local old_started_epoch
    old_pid=$(json_get "$metadata" pid 2>/dev/null || true)
    old_started_epoch=$(json_get "$metadata" started_epoch 2>/dev/null || true)
    if [ -n "$old_pid" ] && lane_group_is_alive "$old_pid" "$old_started_epoch" && [ ! -f "$marker" ]; then
      die "$name is already running as pid $old_pid"
    fi
  fi

  if [ "$resume_mode" = false ]; then
    resolve_worker_settings
  fi
  if [ "$worker" = codex ]; then
    add_uv_cache_writable_root "$worktree"
    add_cpu_slot_writable_root "$worktree"
  fi
  print_worker_settings "$worker"
  if [ "$checkout_mode" = hook ]; then
    env_lines=$(checkout_env_lines "$worktree") || die "invalid checkout env in $worktree/.git/lane-checkout.json"
    while IFS= read -r entry; do
      [ -n "$entry" ] || continue
      checkout_env+=("$entry")
      checkout_env_names="${checkout_env_names:+$checkout_env_names }${entry%%=*}"
    done <<<"$env_lines"
  fi

  mkdir -p "$LANE_HOME"
  rm -f "$marker" "$checkout_state"
  : >"$log"
  prompt=$(build_prompt "$worker" "$brief" "$resume_note")
  started_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

  # perl makes the worker lead a new SESSION and group (sid = pgid = pid; macOS ships no
  # setsid(1)), so stop can target exactly -$launch_pid and closing the launching session
  # cannot reach it: on 2026-09-29 a session close SIGTERMed a `set -m` bgrun job that led its
  # own group but shared the tool shell's session. setsid() refuses a group leader: no `set -m`.
  # UV_CACHE_DIR + --add-dir: the codex sandbox cannot write ~/.cache/uv by default, so uv
  # silently fell back to a per-worktree .uv-cache and re-downloaded the world per lane
  # (13G + 9.7G in two lanes; .claude hit 60G, 2026-09-01). One shared, writable cache.
  # LANE_CHECKOUT_ENV names the hook's settings, which lane-opencode passes through its scrubbed environment.
  nohup /usr/bin/perl -MPOSIX -e 'POSIX::setsid() or die "lane: setsid: $!\n"; exec { $ARGV[0] } @ARGV or die "lane: exec: $!\n"' \
    env PYTHONUNBUFFERED=1 LANE_WORKER=1 UV_CACHE_DIR="$HOME/.cache/uv" LANE_NAME="$name" LANE_REPO="$repo" LANE_LOG="$log" \
    LANE_OPENCODE_HELPER="$LANE_BIN_DIR/lane-opencode" LANE_RETIRE="$LANE_BIN_DIR/lane-retire" LANE_HOME="$LANE_HOME" \
    LANE_ARCHIVE="$LANE_BIN_DIR/lane-archive" \
    LANE_CHECKOUT_MODE="$checkout_mode" LANE_CHECKOUT_BASE="$checkout_base" LANE_BRANCH="$branch" \
    LANE_KEEP_CHECKOUT="$keep_checkout" LANE_CHECKOUT_ENV="$checkout_env_names" \
    ${checkout_env[@]+"${checkout_env[@]}"} bash -c '
    log=$1
    marker=$2
    worker=$3
    prompt=$4
    brief=$5
    worktree=$6
    resume_mode=$7
    checkout_state=$8
    cd "$worktree" || exit 125
    case "$worker" in
      codex)
        # Defaults and resume overrides are resolved in the parent before launch.
        # No apostrophes in this block: it is the body of a single-quoted bash -c script.
        codex_args=(-m "$LANE_CODEX_MODEL")
        if [ -n "$LANE_CODEX_EFFORT" ]; then
          codex_args+=(-c "model_reasoning_effort=\"$LANE_CODEX_EFFORT\"")
        fi
        # Extra writable roots, colon-separated (e.g. a host cpu-slot directory).
        IFS=: read -r -a extra_dirs <<< "$LANE_CODEX_ADD_DIRS"
        for extra_dir in "${extra_dirs[@]}"; do
          if [ -n "$extra_dir" ]; then codex_args+=(--add-dir "$extra_dir"); fi
        done
        if [ "$LANE_CODEX_NETWORK" = 1 ]; then
          codex_args+=(-c "sandbox_workspace_write.network_access=true")
        fi
        caffeinate -i codex exec "${codex_args[@]}" -s workspace-write --add-dir "$HOME/.cache/uv" --skip-git-repo-check "$prompt" < /dev/null
        ;;
      claude)
      # A lane launched from inside a Claude session inherits the parent identity env; without
      # stripping it the worker reports the PARENT session_id to hooks (touched-file trackers,
      # commit ownership guards) and could message peers as the parent (2026-09-28, cost lanes).
      # Retry watchdog (CC 2.1.199+): wait out 429/529 and usage-limit resets in place instead of
      # dying. Both caps default to unlimited in CC 2.1.309, so cap them: 6 h covers a 5 h session
      # reset, a weekly limit fails out; 2 h for capacity; recheck every 15 min for a lifted limit.
        caffeinate -i env -u ANTHROPIC_API_KEY -u CLAUDE_SESSION_ID -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_CHILD_SESSION -u CLAUDECODE -u CLAUDE_PID -u CLAUDE_CODE_MESSAGING_SOCKET -u CLAUDE_CODE_MESSAGING_TOKEN -u CLAUDE_CODE_BRIDGE_SESSION_ID -u CLAUDE_CODE_SESSION_ATTENDED -u CLAUDE_EFFORT CLAUDE_CODE_RETRY_WATCHDOG=1 CLAUDE_CODE_RETRY_WATCHDOG_MAX_USAGE_LIMIT_WAIT_MS=21600000 CLAUDE_CODE_RETRY_WATCHDOG_MAX_WAIT_MS=7200000 CLAUDE_CODE_RETRY_WATCHDOG_USAGE_LIMIT_RECHECK_MS=900000 claude -p --model "$LANE_CLAUDE_MODEL" ${LANE_CLAUDE_EFFORT:+--effort "$LANE_CLAUDE_EFFORT"} --output-format stream-json --verbose "$prompt" < /dev/null
        ;;
      opencode)
        # bin/lane-opencode writes the guard, scrubs the environment, resumes transport errors, waits out a provider at
        # capacity and logs usage. On a resume it continues the last session of the lane.
        LANE_RESUME="$resume_mode" caffeinate -i "$LANE_OPENCODE_HELPER" "$prompt" < /dev/null
        ;;
      fake)
        if [ "$resume_mode" = true ]; then printf "%s\n" "$prompt"; fi
        # A test holds the fake RUNNING until it releases it: the bare 1 s sleep lost the
        # race with `lane run` itself at load average 112 (2026-09-29, DONE before the check).
        held=0
        while [ -n "${LANE_FAKE_HOLD:-}" ] && [ ! -e "$LANE_FAKE_HOLD" ] && [ "$held" -lt 300 ]; do
          sleep 0.1
          held=$((held + 1))
        done
        sleep 1
        echo hi
        ;;
      fake-hang)
        # Long enough to outlast the stall checks on a loaded host (at load ~20 a 30 s hang
        # finished first and the test read DONE:0); every test stops it with `lane stop`.
        sleep 600
        ;;
      *)
        echo "lane: unsupported worker: $worker" >&2
        exit 2
        ;;
    esac > "$log" 2>&1
    rc=$?
    # A finished lane keeps its diff, never its package caches: strip .uv-cache/.venv on
    # exit (rederivable; resume re-syncs from the shared cache). Real worktrees only.
    case "$worktree" in
      */.claude/worktrees/codex-*) rm -rf "$worktree/.uv-cache" "$worktree/.venv" 2>/dev/null || true ;;
    esac
    # Exit 0 harvests the checkout and removes it (bin/lane-retire); a failed or kept lane keeps it for resume. No
    # finished checkout piles up: genomics held 13 GB of finished worktrees and 11 GB of clones on 2026-10-24.
    # The state file is written before the marker, so a watcher that sees the marker reads the final state.
    state="CHECKOUT=none"
    if [ "$LANE_CHECKOUT_MODE" = worktree ] || [ "$LANE_CHECKOUT_MODE" = hook ]; then
      cd / || exit 125
      keep_reason=""
      if [ "$LANE_KEEP_CHECKOUT" = true ]; then keep_reason="launched with --keep-checkout"; fi
      retire_out=$("$LANE_RETIRE" --name "$LANE_NAME" --mode "$LANE_CHECKOUT_MODE" --checkout "$worktree" \
        --repo "$LANE_REPO" --base "$LANE_CHECKOUT_BASE" --branch "$LANE_BRANCH" --harvest-root "$LANE_HOME" \
        --log "$log" --brief "$brief" --exit-code "$rc" --keep "$keep_reason" 2>&1)
      printf "%s\n" "$retire_out" >> "$log"
      state=$(printf "%s\n" "$retire_out" | tail -n 1)
      case "$state" in CHECKOUT=*) ;; *) state="CHECKOUT=kept lane-retire failed; its output is in the log" ;; esac
    fi
    state_tmp="${checkout_state}.tmp.$$"
    printf "%s\n" "$state" > "$state_tmp"
    mv "$state_tmp" "$checkout_state"
    marker_tmp="${marker}.tmp.$$"
    printf "EXIT=%s\n" "$rc" > "$marker_tmp"
    mv "$marker_tmp" "$marker"
    # After a retire, a bounded pass moves lanes that finished over 14 days ago to the SSD (bin/lane-archive). It runs
    # after the marker, so no watcher waits for it.
    case "$state" in
      "CHECKOUT=retired "*) "$LANE_ARCHIVE" --home "$LANE_HOME" --apply --bounded >> "$LANE_HOME/.archive.log" 2>&1 || true ;;
    esac
    exit "$rc"
  ' lane-worker "$log" "$marker" "$worker" "$prompt" "$brief" "$worktree" "$resume_mode" "$checkout_state" </dev/null >/dev/null 2>&1 &
  launch_pid=$!
  disown "$launch_pid" 2>/dev/null || true
  # The worker leads its group only after perl's setsid(); wait for that before the check. The builtin kill sees the
  # group without a ps per poll: ps and tr spun up to 250 polls (~15 s a launch) under the suite's fake ps (2026-10-25).
  for _ in $(seq 1 250); do
    process_group_exists "$launch_pid" && break
    kill -0 "$launch_pid" 2>/dev/null || break
    sleep 0.02
  done

  # A worker that already finished wrote its marker and left no group: that is completion, not an
  # isolation failure (a fast fake worker can exit inside one poll interval).
  if ! process_group_exists "$launch_pid" && [ ! -f "$marker" ]; then
    kill "$launch_pid" 2>/dev/null || true
    die "could not isolate worker process group for pid $launch_pid"
  fi
  started_epoch=$(process_started_epoch "$launch_pid")
  if [ -z "$started_epoch" ]; then
    echo "lane: warning: could not record started_epoch for process group $launch_pid" >&2
  fi
  if ! json_write "$metadata" "$name" "$repo" "$worktree" "$brief" "$launch_pid" "$started_at" "$started_epoch" "$worker" "$base" "$branch" "$no_worktree" "$WORKER_SETTINGS" "$resume_note" "$checkout_mode" "$checkout_base" "$keep_checkout"; then
    kill -TERM -- "-$launch_pid" 2>/dev/null || true
    die "could not write metadata: $metadata"
  fi

  echo "lane: $name pid=$launch_pid worker=$worker"
  echo "  worktree: $worktree"
  echo "  log:      $log"
  echo "  done:     $marker (contains EXIT=<rc>)"
  if [ "$checkout_mode" != none ]; then
    if [ "$keep_checkout" = true ]; then
      echo "  checkout: $checkout_mode, kept after exit (--keep-checkout)"
    else
      echo "  checkout: $checkout_mode, harvested to $LANE_HOME/$name.harvest/ and removed on exit 0 (state: $checkout_state)"
    fi
  fi
  print_watch "$name" "$log" "$marker"
}

cmd_run() {
  [ "$#" -ge 1 ] || die "run requires a name"
  local name="$1"
  shift
  local repo=""
  local brief=""
  local worker="codex"
  local base="HEAD"
  local no_worktree="false"
  local repo_root
  local worktree_and_branch
  local worktree
  local branch
  local existing_repo
  local existing_no_worktree
  local existing_pid
  local existing_started_epoch
  local existing_mode
  local base_given="false"
  local base_oid
  local hook
  local checkout_mode
  local checkout_base=""
  local keep_checkout="false"
  local seed_patch=""
  local seed_list=""
  local seed

  validate_name "$name"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo)
        [ "$#" -ge 2 ] || die "--repo requires a path"
        repo="$2"
        shift 2
        ;;
      --brief)
        [ "$#" -ge 2 ] || die "--brief requires a file"
        brief="$2"
        shift 2
        ;;
      --worker)
        [ "$#" -ge 2 ] || die "--worker requires a value"
        worker="$2"
        shift 2
        ;;
      --base)
        [ "$#" -ge 2 ] || die "--base requires a ref"
        base="$2"
        base_given="true"
        shift 2
        ;;
      --no-worktree)
        no_worktree="true"
        shift
        ;;
      --keep-checkout)
        keep_checkout="true"
        shift
        ;;
      --seed-patch)
        [ "$#" -ge 2 ] || die "--seed-patch requires a file"
        validate_plain_value "seed patch" "$2"
        seed_patch=$(absolute_file "$2" "seed patch")
        shift 2
        ;;
      --seed-file)
        [ "$#" -ge 2 ] || die "--seed-file requires a file"
        validate_plain_value "seed file" "$2"
        seed=$(absolute_file "$2" "seed file")
        seed_list="${seed_list:+$seed_list
}$seed"
        shift 2
        ;;
      *) die "unknown run option: $1" ;;
    esac
  done
  [ -n "$repo" ] || die "run requires --repo"
  [ -n "$brief" ] || die "run requires --brief"
  case "$worker" in codex | claude | opencode | fake | fake-hang) ;; *) die "worker must be codex, claude or opencode" ;; esac
  validate_plain_value "repo" "$repo"
  validate_plain_value "brief" "$brief"
  validate_plain_value "base" "$base"
  brief=$(absolute_file "$brief")
  repo_root=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || die "not a git repository: $repo"
  repo_root=$(cd "$repo_root" && pwd -P)
  git -C "$repo_root" check-ref-format --branch "codex/$name" >/dev/null 2>&1 || die "name does not form a valid git branch: codex/$name"
  hook=$(checkout_hook "$repo_root")
  if [ "$no_worktree" = "true" ]; then
    checkout_mode="none"
    # A third-party worker in the main checkout would read everything the hook withholds.
    if [ -n "$hook" ] && [ "$worker" != claude ]; then
      die "$repo_root declares a checkout hook ($hook): a $worker lane runs only in the checkout it builds, not with --no-worktree"
    fi
  elif [ -n "$hook" ]; then
    checkout_mode="hook"
  else
    checkout_mode="worktree"
  fi
  if [ "$checkout_mode" != hook ] && { [ -n "$seed_patch" ] || [ -n "$seed_list" ]; }; then
    die "--seed-patch and --seed-file need a repo checkout hook (git config lane.checkout)"
  fi
  if [ -f "$(metadata_path "$name")" ]; then
    existing_repo=$(json_get "$(metadata_path "$name")" repo) || die "invalid metadata for $name"
    existing_no_worktree=$(json_get "$(metadata_path "$name")" no_worktree) || die "invalid metadata for $name"
    existing_pid=$(json_get "$(metadata_path "$name")" pid) || die "invalid metadata for $name"
    existing_started_epoch=$(json_get "$(metadata_path "$name")" started_epoch 2>/dev/null || true)
    if [ ! -f "$(done_path "$name")" ] && lane_group_is_alive "$existing_pid" "$existing_started_epoch"; then
      die "$name is already running as pid $existing_pid"
    fi
    [ "$existing_repo" = "$repo_root" ] || die "$name already belongs to repository $existing_repo"
    [ "$existing_no_worktree" = "$no_worktree" ] || die "$name cannot change its --no-worktree mode"
    existing_mode=$(lane_checkout_mode "$(metadata_path "$name")") || die "invalid metadata for $name"
    [ "$existing_mode" = "$checkout_mode" ] || die "$name was recorded with a $existing_mode checkout, not $checkout_mode"
    # A reused hook checkout keeps the base it was cut at unless --base names one (the hook refuses a different one).
    if [ "$checkout_mode" = hook ] && [ "$base_given" = false ] && [ -d "$(hook_checkout_path "$name")" ]; then
      base=$(json_get "$(metadata_path "$name")" base) || die "invalid metadata for $name"
    fi
  fi
  base_oid=$(git -C "$repo_root" rev-parse --verify --quiet "$base^{commit}") || die "base is not a commit in $repo_root: $base"
  case "$checkout_mode" in
    hook)
      worktree=$(ensure_hook_checkout "$name" "$repo_root" "$base_oid" "$hook" "$brief" "$seed_patch" "$seed_list")
      branch=""
      checkout_base=$(<"$worktree/.git/lane-checkout-base")
      ;;
    *)
      local existed="false"
      [ -e "$repo_root/.claude/worktrees/codex-$name" ] && existed="true"
      worktree_and_branch=$(ensure_worktree "$name" "$repo_root" "$base_oid" "$no_worktree")
      worktree=${worktree_and_branch%%$'\t'*}
      branch=${worktree_and_branch#*$'\t'}
      if [ "$checkout_mode" = worktree ]; then
        if [ "$existed" = true ] && [ -f "$(metadata_path "$name")" ]; then
          checkout_base=$(json_get_or "$(metadata_path "$name")" checkout_base "")
        fi
        [ -n "$checkout_base" ] || checkout_base=$(git -C "$worktree" rev-parse HEAD)
      fi
      ;;
  esac
  launch_worker "$name" "$repo_root" "$worktree" "$brief" "$worker" "$base_oid" "$branch" "$no_worktree" false "" \
    "$checkout_mode" "$checkout_base" "$keep_checkout"
}

lane_report() {
  local name="$1"
  local worktree="$2"
  if [ -f "$worktree/.claude/cache/$name-result.md" ]; then
    printf '%s\n' "$worktree/.claude/cache/$name-result.md"
    return
  fi
  require_python
  git -C "$worktree" status --porcelain -z --untracked-files=all | python3 -c '
import os
import sys

root = sys.argv[1]
entries = sys.stdin.buffer.read().split(b"\0")
candidates = []
index = 0
while index < len(entries):
    entry = entries[index].decode("utf-8", "surrogateescape")
    index += 1
    if len(entry) < 4:
        continue
    code, path = entry[:2], entry[3:]
    if code[0] in "RC":
        index += 1
    if "D" in code:
        continue
    if not (path.endswith("-report.md") or path.endswith("-result.md")):
        continue
    full = os.path.join(root, path)
    if os.path.isfile(full):
        candidates.append((os.stat(full).st_mtime_ns, full))
if candidates:
    print(max(candidates)[1])
' "$worktree"
}

build_review_patch() {
  local name="$1"
  local worktree="$2"
  local report="${3:-}"
  local patch="$LANE_HOME/$name.patch"
  local header="${patch}.header.tmp.$$"
  local body="${patch}.body.tmp.$$"
  local file_diff="${patch}.file.tmp.$$"
  local output="${patch}.tmp.$$"
  local path
  local full_path
  local report_relative=""
  local kind
  local size
  local rc

  printf '# lane review patch: %s\n# worktree: %s\n' "$name" "$worktree" >"$header"
  if [ -z "$report" ]; then
    printf '# no lane report found\n' >>"$header"
  fi
  case "$report" in
    "$worktree"/*) report_relative=${report#"$worktree"/} ;;
  esac
  git -C "$worktree" diff --no-ext-diff HEAD -- >"$body"
  while IFS= read -r -d '' path; do
    if [ -n "$report_relative" ] && [ "$path" = "$report_relative" ]; then
      printf '# report attached separately; omitted untracked hunk: %s\n' "$path" >>"$header"
      continue
    fi
    full_path="$worktree/$path"
    if [ ! -f "$full_path" ] || [ -L "$full_path" ]; then
      if [ -L "$full_path" ]; then
        if [ -e "$full_path" ]; then kind="symlink"; else kind="broken symlink"; fi
      elif [ -p "$full_path" ]; then
        kind="fifo"
      elif [ -S "$full_path" ]; then
        kind="socket"
      elif [ -b "$full_path" ]; then
        kind="block device"
      elif [ -c "$full_path" ]; then
        kind="character device"
      else
        kind="non-regular file"
      fi
      printf '# skipped: %s (%s)\n' "$path" "$kind" >>"$header"
      continue
    fi
    size=$(wc -c <"$full_path" | tr -d '[:space:]')
    if [ "$size" -gt 1048576 ]; then
      printf '# skipped oversized untracked file (>1 MB): %s\n' "$path" >>"$header"
      continue
    fi
    if git -C "$worktree" diff --no-ext-diff --no-index -- /dev/null "$path" >"$file_diff"; then
      rc=0
    else
      rc=$?
    fi
    [ "$rc" -eq 0 ] || [ "$rc" -eq 1 ] || die "could not diff untracked file: $path"
    if LC_ALL=C grep -q '^Binary files ' "$file_diff"; then
      printf '# skipped binary untracked file: %s\n' "$path" >>"$header"
    else
      cat "$file_diff" >>"$body"
    fi
  done < <(git -C "$worktree" ls-files --others --exclude-standard -z)
  while IFS= read -r -d '' full_path; do
    path=${full_path#"$worktree"/}
    if git -C "$worktree" check-ignore -q -- "$path"; then
      continue
    fi
    if [ -p "$full_path" ]; then
      kind="fifo"
    elif [ -S "$full_path" ]; then
      kind="socket"
    elif [ -b "$full_path" ]; then
      kind="block device"
    else
      kind="character device"
    fi
    printf '# skipped: %s (%s)\n' "$path" "$kind" >>"$header"
  done < <(find "$worktree" -path "$worktree/.git" -prune -o \( -type p -o -type s -o -type b -o -type c \) -print0)
  printf '\n' >>"$header"
  cat "$header" "$body" >"$output"
  mv "$output" "$patch"
  rm -f "$header" "$body" "$file_diff"
  printf '%s\n' "$patch"
}

write_review_marker() {
  local marker="$1"
  local rc="$2"
  local tmp="${marker}.tmp.$$"
  printf 'EXIT=%s\n' "$rc" >"$tmp"
  mv "$tmp" "$marker"
}

write_review_pid() {
  local output="$1"
  local pid="$2"
  local started_epoch="$3"
  local tmp="${output}.tmp.$$"
  printf '%s\n%s\n' "$pid" "$started_epoch" >"$tmp"
  mv "$tmp" "$output"
}

cmd_review() {
  [ "$#" -ge 1 ] || die "review requires a name"
  local name="$1"
  shift
  local model="gpt-6-astra"
  local effort="high"
  local focus=""
  local out="$LANE_HOME/$name.review.md"
  local bg="false"
  local metadata
  local worktree
  local patch
  local patch_lines
  local report=""
  local brief=""
  local prompt
  local marker
  local pid_file
  local lock
  local review_pid
  local review_started_epoch
  local rc
  local harvest=""
  local -a llmx_args

  validate_name "$name"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --model)
        [ "$#" -ge 2 ] || die "--model requires a value"
        model="$2"
        shift 2
        ;;
      --effort)
        [ "$#" -ge 2 ] || die "--effort requires a value"
        effort="$2"
        shift 2
        ;;
      --focus)
        [ "$#" -ge 2 ] || die "--focus requires a file"
        focus=$(absolute_file "$2" "focus file")
        shift 2
        ;;
      --out)
        [ "$#" -ge 2 ] || die "--out requires a file"
        out="$2"
        shift 2
        ;;
      --report)
        [ "$#" -ge 2 ] || die "--report requires a file"
        report=$(absolute_file "$2" "report file")
        shift 2
        ;;
      --bg)
        bg="true"
        shift
        ;;
      *) die "unknown review option: $1" ;;
    esac
  done
  validate_plain_value "model" "$model"
  validate_plain_value "effort" "$effort"
  validate_plain_value "out" "$out"
  metadata=$(metadata_path "$name")
  [ -f "$metadata" ] || unknown_lane "$name"
  worktree=$(json_get "$metadata" worktree) || die "invalid metadata: $metadata"
  if [ ! -d "$worktree" ]; then
    # A retired lane is reviewed from its harvest: the same diff, plus any commits it made.
    harvest=$(latest_harvest "$name") || die "worktree no longer exists and $name has no harvest: $worktree"
  else
    git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "recorded worktree is not a git repository: $worktree"
  fi
  marker=$(review_done_path "$name")
  pid_file=$(review_pid_path "$name")
  lock=$(review_lock_path "$name")
  if [ ! -f "$marker" ] && [ -f "$pid_file" ]; then
    review_pid=$(sed -n '1p' "$pid_file")
    review_started_epoch=$(sed -n '2p' "$pid_file")
    if review_process_is_alive "$review_pid" "$review_started_epoch"; then
      die "$name review already running as pid $review_pid"
    fi
  fi
  mkdir "$lock" 2>/dev/null || die "$name review already running"
  trap 'rmdir "$lock" 2>/dev/null || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  if [ -z "$report" ] && [ -n "$focus" ]; then
    case "$(basename "$focus")" in
      *-report.md) report="$focus" ;;
      *) ;;
    esac
  fi
  if [ -z "$report" ] && [ -n "$harvest" ]; then
    if [ -f "$harvest/cache/$name-result.md" ]; then report="$harvest/cache/$name-result.md"; fi
  elif [ -z "$report" ]; then
    report=$(lane_report "$name" "$worktree")
  fi
  brief=$(json_get "$metadata" brief 2>/dev/null || true)
  if [ -n "$brief" ] && [ ! -f "$brief" ]; then
    brief=""
  fi
  if [ -n "$harvest" ]; then
    patch="$LANE_HOME/$name.patch"
    {
      printf '# lane review patch: %s\n# harvest: %s\n' "$name" "$harvest"
      if [ -z "$report" ]; then printf '# no lane report found\n'; fi
      printf '\n'
      cat "$harvest/lane.patch"
      if [ -f "$harvest/commits.patch" ]; then cat "$harvest/commits.patch"; fi
    } >"$patch.tmp.$$"
    mv "$patch.tmp.$$" "$patch"
  else
    patch=$(build_review_patch "$name" "$worktree" "$report")
  fi
  echo "lane: report: ${report:-none}"
  echo "lane: brief: ${brief:-none}"
  patch_lines=$(wc -l <"$patch" | tr -d '[:space:]')
  echo "lane: patch: $patch ($patch_lines lines)"
  prompt='Review the attached patch for correctness across these axes: functional behavior, edge cases and failure handling, concurrency and state safety, and test/contract coverage.
Return severity-ranked findings under each axis. Every finding must cite file:line from the patch and give a concrete failure scenario. If an axis has no finding, say exactly "no defect found" for that axis. Do not restate the diff.'
  if [ -z "$report" ]; then
    if [ -n "$brief" ]; then
      prompt="$prompt
No lane report was found; only the patch and the lane brief are available."
    else
      prompt="$prompt
No lane report was found; only the patch is available."
    fi
  fi
  if [ -n "$focus" ] && [ "$focus" != "$report" ]; then
    prompt="$prompt

Additional review axes:
$(<"$focus")"
  fi

  llmx_args=(chat --subscription -m "$model" -e "$effort" --timeout 900 -f "$patch")
  if [ -n "$report" ]; then
    llmx_args+=(-f "$report")
  fi
  if [ -n "$brief" ]; then
    llmx_args+=(-f "$brief")
  fi
  llmx_args+=(-o "$out" "$prompt")
  review_log=$(review_log_path "$name")
  rm -f "$marker" "$pid_file" "$review_log"
  if [ "$bg" = "true" ]; then
    nohup bash -c '
      lock=$1
      marker=$2
      shift 2
      cleanup() { rmdir "$lock" 2>/dev/null || true; }
      trap cleanup EXIT
      trap "exit 130" INT
      trap "exit 143" TERM
      if "$@"; then rc=0; else rc=$?; fi
      tmp="${marker}.tmp.$$"
      printf "EXIT=%s\n" "$rc" >"$tmp"
      mv "$tmp" "$marker"
      exit "$rc"
    ' lane-review "$lock" "$marker" llmx "${llmx_args[@]}" </dev/null >"$review_log" 2>&1 &
    review_pid=$!
    trap - EXIT INT TERM
    review_started_epoch=$(process_started_epoch "$review_pid")
    if [ -z "$review_started_epoch" ]; then
      echo "lane: warning: could not record started_epoch for review pid $review_pid" >&2
    fi
    write_review_pid "$pid_file" "$review_pid" "$review_started_epoch"
    echo "lane: review pid=$review_pid"
    echo "  out:  $out"
    echo "  done: $marker (contains EXIT=<rc>)"
    echo "  log:  $review_log (llmx stdout+stderr)"
    return
  fi

  echo "lane: review out: $out"
  review_started_epoch=$(process_started_epoch "$$")
  if [ -z "$review_started_epoch" ]; then
    echo "lane: warning: could not record started_epoch for review pid $$" >&2
  fi
  write_review_pid "$pid_file" "$$" "$review_started_epoch"
  if llmx "${llmx_args[@]}"; then
    rc=0
  else
    rc=$?
  fi
  write_review_marker "$marker" "$rc"
  rmdir "$lock" 2>/dev/null || true
  trap - EXIT INT TERM
  return "$rc"
}

review_state() {
  local name="$1"
  local marker
  local pid_file
  local marker_value
  local pid
  local started_epoch
  marker=$(review_done_path "$name")
  pid_file=$(review_pid_path "$name")
  if [ -f "$marker" ]; then
    marker_value=$(sed -n '1s/^EXIT=//p' "$marker")
    case "$marker_value" in
      "" | *[!0-9]*) echo "DONE:?" ;;
      *) echo "DONE:$marker_value" ;;
    esac
  elif [ -f "$pid_file" ]; then
    pid=$(sed -n '1p' "$pid_file")
    started_epoch=$(sed -n '2p' "$pid_file")
    if review_process_is_alive "$pid" "$started_epoch"; then echo "RUNNING"; else echo "-"; fi
  else
    echo "-"
  fi
}

# One `lane ls` row from ls_rows' fields.
ls_row() {
  local name="$1"
  local pid="$2"
  local started_at="$3"
  local started_epoch="$4"
  local dirty="$5"
  local stall_min="$6"
  local state
  local age
  local review
  state=$(lane_state "$name" "$pid" "$started_epoch" "$stall_min")
  age=$(format_age "$(log_age_seconds "$(log_path "$name")")")
  if [ "$dirty" = "?" ] && grep -q '^CHECKOUT=retired ' "$(checkout_state_path "$name")" 2>/dev/null; then
    dirty="ret"
  fi
  review=$(review_state "$name")
  printf '%-20s %-10s %-8s %-21s %-5s %s\n' "$name" "$state" "$age" "$started_at" "$dirty" "$review"
}

cmd_ls() {
  local stall_min="$DEFAULT_STALL_MIN"
  local rows
  local name
  local pid
  local started_at
  local started_epoch
  local dirty
  local out_dir
  local out_file
  local count=0
  local names=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --stall-min)
        [ "$#" -ge 2 ] || die "--stall-min requires minutes"
        stall_min="$2"
        shift 2
        ;;
      *) die "unknown ls option: $1" ;;
    esac
  done
  case "$stall_min" in "" | *[!0-9]*) die "--stall-min must be a non-negative integer" ;; esac
  mkdir -p "$LANE_HOME"
  printf '%-20s %-10s %-8s %-21s %-5s %s\n' "NAME" "STATE" "LOG-AGE" "STARTED" "DIRTY" "REVIEW"
  set -- "$LANE_HOME"/*.json
  [ -e "$1" ] || return 0
  rows=$(ls_rows "$@") || die "could not read lane metadata in $LANE_HOME"
  while IFS=$'\x1f' read -r -u 3 name pid _; do
    [ "$name" != "!" ] || die "invalid metadata: $pid"
  done 3<<<"$rows"
  # Rows render eight at a time into numbered files, printed in order: a row runs a dozen short processes, which took
  # 21 s over 378 lanes one row at a time (2026-10-25).
  out_dir=$(mktemp -d "${TMPDIR:-/tmp}/lane-ls.XXXXXX") || die "could not make a directory for lane ls rows"
  while IFS=$'\x1f' read -r -u 3 name pid started_at started_epoch _ dirty; do
    printf -v out_file '%s/%06d' "$out_dir" "$count"
    ls_row "$name" "$pid" "$started_at" "$started_epoch" "$dirty" "$stall_min" >"$out_file" 3<&- &
    names+=("$name")
    count=$((count + 1))
    [ $((count % 8)) -ne 0 ] || wait
  done 3<<<"$rows"
  wait
  # A row job that failed left an empty file: say which lane, as the serial loop did by stopping there.
  count=0
  for out_file in "$out_dir"/*; do
    [ -s "$out_file" ] || {
      rm -rf -- "$out_dir"
      die "could not render the lane ls row for ${names[$count]}"
    }
    count=$((count + 1))
  done
  cat "$out_dir"/*
  rm -rf -- "$out_dir"
}

archive_log() {
  local name="$1"
  local log
  local archive
  local number=1
  log=$(log_path "$name")
  [ -e "$log" ] || return 0
  while :; do
    archive="$LANE_HOME/$name.stalled-$number.log"
    [ -e "$archive" ] || break
    number=$((number + 1))
  done
  mv "$log" "$archive"
  echo "lane: archived log to $archive"
}

stop_lane() {
  local name="$1"
  local metadata
  local pid
  local started_epoch
  local marker
  metadata=$(metadata_path "$name")
  [ -f "$metadata" ] || unknown_lane "$name"
  pid=$(json_get "$metadata" pid) || die "invalid metadata: $metadata"
  started_epoch=$(json_get "$metadata" started_epoch 2>/dev/null || true)
  marker=$(done_path "$name")
  if [ -f "$marker" ]; then
    echo "lane: $name already completed; no process signalled"
  elif lane_group_is_alive "$pid" "$started_epoch"; then
    kill -TERM -- "-$pid"
    echo "lane: signalled process group $pid"
    wait_for_group_exit "$pid" "$started_epoch" 50 || die "process group $pid did not stop after SIGTERM"
  else
    echo "lane: process group $pid is not running"
  fi
  archive_log "$name"
  rm -f "$(done_path "$name")"
}

cmd_stop() {
  [ "$#" -eq 1 ] || die "stop requires exactly one name"
  validate_name "$1"
  stop_lane "$1"
}

cmd_resume() {
  [ "$#" -ge 1 ] || die "resume requires a name"
  local name="$1"
  shift
  local metadata
  local repo
  local worktree
  local brief
  local worker
  local base
  local branch
  local no_worktree
  local note_source=""
  local note_path=""
  local no_note="false"
  local consumed
  local consumed_number=1
  local checkout_mode
  local checkout_base
  local keep_checkout
  local hook
  local harvest
  validate_name "$name"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --note)
        [ "$#" -ge 2 ] || die "--note requires a file"
        [ "$no_note" = "false" ] && [ -z "$note_source" ] || die "pass only one of --note or --no-note"
        note_source=$(absolute_file "$2" "resume note")
        shift 2
        ;;
      --no-note)
        [ "$no_note" = "false" ] && [ -z "$note_source" ] || die "pass only one of --note or --no-note"
        no_note="true"
        shift
        ;;
      *) die "unknown resume option: $1" ;;
    esac
  done
  metadata=$(metadata_path "$name")
  [ -f "$metadata" ] || unknown_lane "$name"
  repo=$(json_get "$metadata" repo) || die "invalid metadata: $metadata"
  worktree=$(json_get "$metadata" worktree) || die "invalid metadata: $metadata"
  brief=$(json_get "$metadata" brief) || die "invalid metadata: $metadata"
  worker=$(json_get "$metadata" worker) || die "invalid metadata: $metadata"
  base=$(json_get "$metadata" base) || die "invalid metadata: $metadata"
  branch=$(json_get "$metadata" branch) || die "invalid metadata: $metadata"
  no_worktree=$(json_get "$metadata" no_worktree) || die "invalid metadata: $metadata"
  checkout_mode=$(lane_checkout_mode "$metadata") || die "invalid metadata: $metadata"
  checkout_base=$(json_get_or "$metadata" checkout_base "") || die "invalid metadata: $metadata"
  keep_checkout=$(json_get_or "$metadata" keep_checkout "false") || die "invalid metadata: $metadata"
  [ -f "$brief" ] || die "brief no longer exists: $brief"
  if [ ! -d "$worktree" ]; then
    if harvest=$(latest_harvest "$name"); then
      die "$name was retired (harvest: $harvest); start a new lane from it: lane run <new-name> ... --seed-patch $harvest/lane.patch [--seed-file $harvest/cache/<file>]$( [ ! -s "$harvest/commits.patch" ] || printf '; its commits are in %s (git am them in the new checkout)' "$harvest/commits.patch")"
    fi
    die "worktree no longer exists: $worktree"
  fi
  hook=$(checkout_hook "$repo")
  # A lane cut before its repo declared a hook sits in an unfiltered checkout: cmd_run's rule holds on resume too.
  if [ "$checkout_mode" != hook ] && [ -n "$hook" ] && [ "$worker" != claude ]; then
    die "$repo declares a checkout hook ($hook): a $worker lane resumes only in a checkout the hook built, and $name has a $checkout_mode checkout; start a new lane"
  fi
  [ "$checkout_mode" != hook ] || [ -n "$hook" ] || die "$repo no longer declares the checkout hook $name was built by"
  resolve_worker_settings "$metadata"
  # The note is settled before the hook runs, so the hook checks the text the worker will read.
  if [ "$no_note" = "false" ]; then
    note_path="$LANE_HOME/$name.resume-note.md"
    if [ -n "$note_source" ]; then
      [ "$note_source" = "$note_path" ] || cp "$note_source" "$note_path"
    elif [ ! -f "$note_path" ]; then
      die "no resume note for $name (pass --note <file> or --no-note)"
    fi
  else
    # A note-carrying run that was stopped or failed never finished its revision: re-send it, or
    # the worker silently redoes its first task from the brief alone (2026-10-20, three lanes).
    local last_note
    local last_exit=""
    last_note=$(json_get "$metadata" last_note 2>/dev/null || true)
    if [ -f "$(done_path "$name")" ]; then
      last_exit=$(sed -n '1s/^EXIT=//p' "$(done_path "$name")")
    fi
    if [ -n "$last_note" ] && [ "$last_exit" != "0" ]; then
      [ -f "$last_note" ] || die "interrupted run's note is missing: $last_note"
      note_path="$last_note"
      echo "lane: re-sending the interrupted run's note: $last_note"
    fi
  fi
  if [ "$checkout_mode" = hook ]; then
    run_checkout_hook "$hook" "$name" "$repo" "$brief" "$note_path" "" "" --verify "$worktree" "$base" ||
      die "checkout hook $hook refused to resume in $worktree (rc=$?)"
  fi
  if [ "$no_note" = "false" ]; then
    while [ -e "$LANE_HOME/$name.resume-note.consumed-$consumed_number.md" ]; do
      consumed_number=$((consumed_number + 1))
    done
    consumed="$LANE_HOME/$name.resume-note.consumed-$consumed_number.md"
    if ! mv "$note_path" "$consumed"; then
      die "resume note for $name was already claimed"
    fi
    note_path="$consumed"
    echo "lane: claimed resume note: $consumed"
  fi
  stop_lane "$name"
  launch_worker "$name" "$repo" "$worktree" "$brief" "$worker" "$base" "$branch" "$no_worktree" true "$note_path" \
    "$checkout_mode" "$checkout_base" "$keep_checkout"
}

cmd_reap() {
  [ "$#" -ge 1 ] || die "reap requires a name"
  local name="$1"
  shift
  local force="false"
  local metadata
  local pid
  local started_epoch
  local state
  local repo
  local worktree
  local branch
  local brief
  local checkout_mode
  local checkout_base
  local retire_out
  local last
  local retired="false"
  validate_name "$name"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force)
        force="true"
        shift
        ;;
      *) die "unknown reap option: $1" ;;
    esac
  done
  metadata=$(metadata_path "$name")
  [ -f "$metadata" ] || unknown_lane "$name"
  pid=$(json_get "$metadata" pid) || die "invalid metadata: $metadata"
  started_epoch=$(json_get "$metadata" started_epoch 2>/dev/null || true)
  state=$(lane_state "$name" "$pid" "$started_epoch" "$DEFAULT_STALL_MIN")
  # DEAD is a stopped or crashed lane: no process, no marker. Its checkout is harvested like a finished one.
  case "$state" in DONE:\?) die "refusing to reap $name with an invalid completion marker" ;; DONE:* | DEAD) ;; *) die "refusing to reap $name in state $state" ;; esac
  repo=$(json_get "$metadata" repo) || die "invalid metadata: $metadata"
  worktree=$(json_get "$metadata" worktree) || die "invalid metadata: $metadata"
  branch=$(json_get "$metadata" branch) || die "invalid metadata: $metadata"
  brief=$(json_get "$metadata" brief) || die "invalid metadata: $metadata"
  checkout_mode=$(lane_checkout_mode "$metadata") || die "invalid metadata: $metadata"
  checkout_base=$(json_get_or "$metadata" checkout_base "") || die "invalid metadata: $metadata"
  case "$checkout_mode" in
    none) die "refusing to reap a --no-worktree lane" ;;
    hook) [ "$worktree" = "$(hook_checkout_path "$name")" ] || die "refusing unexpected checkout path: $worktree" ;;
    *)
      [ "$worktree" = "$repo/.claude/worktrees/codex-$name" ] || die "refusing unexpected worktree path: $worktree"
      [ "$branch" = "codex/$name" ] || die "refusing unexpected branch: $branch"
      ;;
  esac

  if [ -d "$worktree" ]; then
    echo "lane: git diff --stat for $worktree"
    git -C "$worktree" diff --no-ext-diff HEAD --stat --
    echo "lane: untracked files"
    git -C "$worktree" ls-files --others --exclude-standard
    if [ "$force" != "true" ]; then
      echo "lane: retained $name; pass --force to harvest it into $LANE_HOME/$name.harvest/ and remove its checkout"
      return
    fi
    if lane_group_is_alive "$pid" "$started_epoch"; then
      wait_for_group_exit "$pid" "$started_epoch" 10 || die "refusing to reap while process group $pid is still exiting"
    fi
    # lane stop archives the log as <name>.stalled-<n>.log, so a stopped lane's newest archive is its run log.
    local reap_log
    reap_log=$(log_path "$name")
    if [ ! -f "$reap_log" ]; then
      reap_log=$(ls -t "$LANE_HOME/$name".stalled-*.log 2>/dev/null | head -n 1)
    fi
    retire_out=$("$LANE_BIN_DIR/lane-retire" --reap --name "$name" --mode "$checkout_mode" --checkout "$worktree" \
      --repo "$repo" --base "$checkout_base" --branch "$branch" --harvest-root "$LANE_HOME" \
      --log "$reap_log" --brief "$brief") || die "lane-retire refused $name: $retire_out"
    printf '%s\n' "$retire_out"
    last=$(printf '%s\n' "$retire_out" | tail -n 1)
    case "$last" in CHECKOUT=retired\ *) ;; *) die "kept $name: ${last#CHECKOUT=}" ;; esac
    retired="true"
  else
    echo "lane: $name has no checkout left: $(cat "$(checkout_state_path "$name")" 2>/dev/null || echo "no retire record")"
    if [ "$force" != "true" ]; then
      echo "lane: retained $name's metadata and log; pass --force to drop them (its harvest stays)"
      return
    fi
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null &&
      [ "$checkout_mode" = worktree ]; then
      echo "lane: branch $branch stays: lane-retire kept it because no other ref holds its commits"
    fi
  fi
  rm -f "$metadata" "$(done_path "$name")" "$(log_path "$name")" "$LANE_HOME/$name.opencode-session" \
    "$(checkout_state_path "$name")"
  echo "lane: reaped $name; harvests stay in $LANE_HOME/$name.harvest/"
  [ "$retired" = false ] || archive_pass
}

cmd_archive() {
  case "$*" in "" | --apply) ;; *) die "usage: lane archive [--apply]" ;; esac
  "$LANE_BIN_DIR/lane-archive" --home "$LANE_HOME" "$@"
}

cmd_unarchive() {
  [ "$#" -eq 1 ] || die "unarchive requires exactly one name"
  validate_name "$1"
  "$LANE_BIN_DIR/lane-archive" --home "$LANE_HOME" --unarchive "$1"
}

main() {
  [ "$#" -ge 1 ] || {
    usage
    exit 2
  }
  local command="$1"
  shift
  case "$command" in
    -h | --help | help) usage ;;
    run | review | ls | stop | resume | reap | archive | unarchive)
      init_lane_home
      case "$command" in
        run) cmd_run "$@" ;;
        review) cmd_review "$@" ;;
        ls) cmd_ls "$@" ;;
        stop) cmd_stop "$@" ;;
        resume) cmd_resume "$@" ;;
        reap) cmd_reap "$@" ;;
        archive) cmd_archive "$@" ;;
        unarchive) cmd_unarchive "$@" ;;
      esac
      ;;
    *)
      usage
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
