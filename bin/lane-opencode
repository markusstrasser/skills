#!/usr/bin/env bash
# lane-opencode — lane's opencode worker: one headless `opencode run` in the lane's worktree. The default model is
# DeepSeek V4.1 Flash on DeepInfra with thinking on (about $0.05 a lane: ~/Projects/evals/opencode_deepseek_probe).
#
# OpenCode has no sandbox. The guard is a scrubbed environment, so no key reaches the model's shell, and a deny-list
# in <worktree>/.opencode/opencode.json, the only project config OpenCode v2 reads. Its rules, measured on v2.1.4
# (2026-10-24, DeepSeek V4.1 Flash writing files under each rule form):
#   - the last matching rule wins;
#   - external_directory takes absolute globs and never matches the project itself, so denying the main checkout
#     leaves a worktree inside it writable;
#   - file rules (read, edit, ...) inside the project match project-relative paths; an absolute one never matches;
#   - shell commands are gated by command patterns alone.
# So the deny-list stops mistakes, not an adversary; the parent still reviews every diff. A repo adds its own rules in
# .claude/lane-opencode.json: {"allow_dirs": [absolute dirs re-allowed after the denies], "shell_deny": [patterns]}.
# A repo checkout hook (lane's --help) adds rules for the checkout it built in <worktree>/.git/lane-checkout.json:
# {"opencode_permissions": [rules]}, appended after allow_dirs, so they override it; its "env" settings reach the
# model's shell through LANE_CHECKOUT_ENV.
#
# usage (lane runs it in the worktree): lane-opencode <prompt>
# env from lane: LANE_NAME LANE_REPO LANE_LOG LANE_OPENCODE_MODEL
set -u

name=${LANE_NAME:?lane-opencode: LANE_NAME is not set}
repo=${LANE_REPO:?lane-opencode: LANE_REPO is not set}
log=${LANE_LOG:?lane-opencode: LANE_LOG is not set}
model=${LANE_OPENCODE_MODEL:-deepinfra/deepseek-ai/DeepSeek-V4.1-Flash-1017}
prompt=${1:?lane-opencode: no prompt}
# OpenCode's shell tool offers a background option whose description says "end your response; you will be resumed
# automatically when the command finishes". Under `opencode run` nothing resumes the session: the run exits with the
# turn and its background commands stop. A teleport lane ended so at step 61 of its brief, its build still queued
# for a cargo slot (arena, 2026-10-26). The default foreground timeout, 120000 ms, kills longer commands.
headless_note="This run is headless: nothing resumes you after your turn ends, so a background command's result never \
reaches you, and the lane ends with your turn. Run every command in the foreground, never with the shell tool's \
background option, and set its timeout above the command's expected time (the default, 120000 ms, kills it; a build \
queued behind other lanes can take 30 minutes, so give builds and test runs 3600000)."
prompt="$prompt

$headless_note"
worktree=$(pwd -P)
# The lane's last OpenCode session, kept beside its log so `lane resume` continues it with its context.
session_file="${log%.log}.opencode-session"

write_guard() {
  python3 - "$repo" "$worktree" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

repo, worktree = Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve()
home = Path.home()
local_path = repo / ".claude" / "lane-opencode.json"
local = json.loads(local_path.read_text()) if local_path.is_file() else {}
rules = []


def directory(path, effect):
    for suffix in ("", "/*", "/**"):
        rules.append({"action": "external_directory", "resource": f"{path}{suffix}", "effect": effect})


# The main checkout and its other worktrees. These rules never match the lane's own worktree, the project.
if worktree != repo:
    directory(repo, "deny")
for secret in (".ssh", ".gnupg", ".aws", ".docker", ".config", ".netrc", ".modal.toml", ".codex", ".claude",
               ".local/share/opencode", "Library/Keychains", ".cache/lanes"):
    directory(home / secret, "deny")
for allowed in local.get("allow_dirs", []):
    directory(Path(allowed), "allow")
checkout_path = worktree / ".git" / "lane-checkout.json"
if checkout_path.is_file():
    checkout_rules = json.loads(checkout_path.read_text()).get("opencode_permissions", [])
    if not isinstance(checkout_rules, list) or not all(
            isinstance(rule, dict) and set(rule) == {"action", "resource", "effect"} for rule in checkout_rules):
        sys.exit(f"lane-opencode: {checkout_path} opencode_permissions must be a list of action/resource/effect rules")
    rules += checkout_rules
for resource in (".opencode", ".opencode/*", ".opencode/**", ".git/lane-checkout.json"):
    rules.append({"action": "edit", "resource": resource, "effect": "deny"})

# Git state belongs to the parent: the lane edits files, the parent stages, commits and merges.
git_verbs = ("add", "commit", "push", "pull", "fetch", "stash", "switch", "checkout", "reset", "restore", "rebase",
             "merge", "cherry-pick", "revert", "am ", "rm ", "mv ", "branch", "tag", "worktree", "remote",
             "update-ref", "update-index", "symbolic-ref", "gc", "prune", "reflog", "clean", "config", "notes",
             "filter-", "replace", "-C", "-c ", "--git-dir", "--work-tree")
patterns = [f"*git {verb}*" for verb in git_verbs]
patterns += ["*pkill*", "*killall*", "*sudo *", "*launchctl*", "*security find-*", "*security dump-*",
             "*security export*", "*security add-*", "*security delete-*", "*Keychains*", "*/.ssh*", "*/.config/*",
             f"*{home}/.claude/*", "*~/.claude/*", "*/.codex/*", "*/.local/share/opencode*", "*auth.json*",
             "*opencode.db*", "*API_KEY*", "*/.netrc*", "*.modal.toml*", "*/.aws/*", "*.opencode*"]
if worktree != repo:
    # Shell commands that name the main checkout's tracked tree; the entry holding the worktree stays reachable.
    own = worktree.relative_to(repo).parts[0] if worktree.is_relative_to(repo) else None
    entries = subprocess.run(["git", "-C", str(repo), "ls-tree", "--name-only", "HEAD"],
                             capture_output=True, text=True, check=True).stdout.split("\n")
    patterns += [f"*{repo}/{entry}*" for entry in entries if entry and entry != own]
    patterns += [f"*cd {repo}", f"*cd {repo} *", f"*cd {repo};*", f"*cd {repo}&*", f"*cd {repo}/ *"]
for pattern in patterns + local.get("shell_deny", []):
    # v2 names its shell tool `shell`; `bash` covers v1 configs.
    for action in ("shell", "bash"):
        rules.append({"action": action, "resource": pattern, "effect": "deny"})
# Nobody answers a question in a headless run, and a doom loop only burns tokens.
rules.append({"action": "doom_loop", "resource": "*", "effect": "deny"})
rules.append({"action": "question", "resource": "*", "effect": "deny"})

config = {
    "$schema": "https://opencode.ai/config.json",
    # DeepInfra thinks only when asked: OpenCode requests no reasoning unless reasoningEffort is set (0 reasoning
    # tokens in 777 genomics lane messages through 2026-10-22).
    "providers": {"deepinfra": {"settings": {"reasoningEffort": "high"}}},
    "permissions": rules,
}
out = worktree / ".opencode" / "opencode.json"
out.parent.mkdir(exist_ok=True)
out.write_text(json.dumps(config, indent=1) + "\n")
# Keep the guard out of `git status` and the lane's diff.
exclude = Path(subprocess.run(
    ["git", "-C", str(worktree), "rev-parse", "--path-format=absolute", "--git-path", "info/exclude"],
    capture_output=True, text=True, check=True).stdout.strip())
lines = exclude.read_text().splitlines() if exclude.is_file() else []
if "/.opencode/" not in lines:
    exclude.parent.mkdir(parents=True, exist_ok=True)
    with exclude.open("a") as handle:
        handle.write(("\n" if lines and lines[-1] else "") + "/.opencode/\n")
print(f"lane-opencode: guard {out}: {len(rules)} rules")
PY
}

# How the run ended, from the JSON event log and the exit code: "<verdict> <session>", where the verdict is ok,
# backgrounded (ended after starting a background shell, with no foreground shell since), quota, transport,
# interrupted, rate_limit:<seconds the provider asked to wait, or -> or error:<type>, and the session is the last one
# the log names (may be empty).
last_event() {
  python3 - "$log" "$1" "$2" <<'PY'
import json
import math
import sys

rc = int(sys.argv[2])
# The verdict comes from this attempt's events only (they start at byte argv[3]): an attempt that dies before its
# first event must not inherit the previous attempt's refusal. The session may come from any attempt.
start = int(sys.argv[3])
events = []
with open(sys.argv[1], "rb") as stream:
    for offset_line in stream.read().splitlines(keepends=True):
        here, start = start <= 0, start - len(offset_line)
        try:
            event = json.loads(offset_line.decode("utf-8", errors="replace"))
        except ValueError:
            continue
        if isinstance(event, dict) and "type" in event:
            events.append((here, event))
session = next((event["sessionID"] for _, event in reversed(events) if event.get("sessionID")), "")
events = [event for here, event in events if here]
if not events:
    print(f"error:empty {session}")
    raise SystemExit(0)
last = events[-1]
if last.get("type") != "error":
    # A failed exit without an error event is a run cut off mid-step: when the network dropped, OpenCode exited 1
    # right after a step_start and two arena lanes ended as finished (2026-10-24).
    if rc != 0:
        print(f"interrupted {session}")
        raise SystemExit(0)
    backgrounded = False
    for event in events:
        part = event.get("part") or {}
        if event.get("type") == "tool_use" and part.get("tool") == "shell":
            backgrounded = bool(((part.get("state") or {}).get("input") or {}).get("background"))
    print(f"backgrounded {session}" if backgrounded else f"ok {session}")
    raise SystemExit(0)
error = last.get("error") or {}
kind = str(error.get("type", "unknown"))
message = str(error.get("message", ""))
# An empty balance (402) never recovers on retry; the socket closing or DNS failing after a laptop sleep does, and so
# does a provider at capacity: LithosAI's Flash-ultra tier answered 429 provider_overloaded ("the model is at
# capacity, retry shortly", retryAfterMs about 4000), and three lanes died on their first attempt (2026-10-24).
if "quota" in kind or "402" in message or "Insufficient" in message or "balance" in message.lower():
    print(f"quota {session}")
elif kind == "provider.rate-limit" or str(error.get("status")) == "429" or "at capacity" in message:
    try:
        asked = max(0, math.ceil(float(error["retryAfterMs"]) / 1000))
    except (KeyError, TypeError, ValueError, OverflowError):
        asked = "-"
    print(f"rate_limit:{asked} {session}")
elif kind == "provider.transport" or any(token in message for token in (
        "Transport", "socket connection", "ECONNRESET", "fetch failed", "ENOTFOUND", "EAI_AGAIN")):
    print(f"transport {session}")
else:
    print(f"error:{kind} {session}")
PY
}

usage_line() {
  python3 - "$log" <<'PY'
import json
import sys

totals = {"steps": 0, "input": 0, "output": 0, "reasoning": 0, "cache_read": 0, "cache_write": 0}
cost = 0.0
with open(sys.argv[1], encoding="utf-8", errors="replace") as stream:
    for line in stream:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict) or event.get("type") != "step_finish":
            continue
        part = event.get("part") or {}
        tokens = part.get("tokens") or {}
        cache = tokens.get("cache") or {}
        totals["steps"] += 1
        for key in ("input", "output", "reasoning"):
            totals[key] += int(tokens.get(key) or 0)
        totals["cache_read"] += int(cache.get("read") or 0)
        totals["cache_write"] += int(cache.get("write") or 0)
        cost += float(part.get("cost") or 0)
# OpenCode's cost is its catalog's list price, about 2x what DeepInfra bills (probe, 2026-10-21).
print("lane-opencode: usage " + " ".join(f"{key}={value}" for key, value in totals.items()) + f" cost_list={cost:.4f}")
PY
}

case $model in
  deepinfra/*) host=api.deepinfra.com ;;
  deepseek/*) host=api.deepseek.com ;;
  lithosai/*) host=api.lithosai.cloud ;;
  *) host="" ;;
esac
# Set and empty: resume without waiting for the provider (tests).
host=${LANE_OPENCODE_PROVIDER_HOST-$host}
if [ -z "$host" ] && [ -z "${LANE_OPENCODE_PROVIDER_HOST+set}" ]; then
  # A provider missing above skips the wait unnoticed, as LithosAI lanes did until 2026-10-24.
  echo "lane-opencode: [DEGRADED] no provider host known for $model: a transport resume will not wait out a DNS outage"
fi
# A provider at capacity or rate-limiting: wait at least the retryAfterMs it sent, backing off 30, 60, 120, then 240 s
# over refusals in a row, and stop with exit 85 once one spell of refusals would pass about 20 min of waiting
# (2026-10-24). After two refusals in a row a LithosAI -ultra or -fast model steps down one tier: the same weights,
# served slower. Tests shrink the floor and the cap.
overload_floor=${LANE_OPENCODE_OVERLOAD_FLOOR:-30}
overload_cap=${LANE_OPENCODE_OVERLOAD_CAP:-1200}
if ! [[ $overload_floor =~ ^[1-9][0-9]*$ && $overload_cap =~ ^[0-9]+$ ]]; then
  echo "lane-opencode: LANE_OPENCODE_OVERLOAD_FLOOR must be a positive integer and LANE_OPENCODE_OVERLOAD_CAP a whole number" >&2
  exit 2
fi
# Each lane gets its own TMPDIR, removed at the end: OpenCode leaves throwaway tree copies in $TMPDIR/opencode
# (4.7 GB from three genomics lanes, 2026-10-21).
tmp="/tmp/lane-opencode/$name"
mkdir -p "$tmp" || exit 98
write_guard || exit 96
echo "lane-opencode: model $model"

resume_prompt="The previous attempt of this session ended on a transport error, a dropped connection or a provider at \
capacity, not by your choice. Continue the task from where you stopped: check git status and your result file first, \
then finish every deliverable the task names."
background_prompt="Your turn ended after you started a shell command in the background. $headless_note The end of \
your turn stopped that command. Run it again in the foreground, check git status and your result file, then finish \
every deliverable the task names."
# Turns ended on a background command that were resumed; past the cap the lane ends as it is, loudly.
background_resumes=0
session=""
# `lane resume` continues the lane's session, so the worker keeps what it learned; the prompt restates the task.
if [ "${LANE_RESUME:-false}" = true ] && [ -s "$session_file" ]; then
  session=$(<"$session_file")
  prompt="This continues your session: the lane was stopped or cut off, not by your choice. Check git status and your \
result file first, then finish every deliverable the task names. The task, as given:

$prompt"
  echo "lane-opencode: continuing session $session"
fi
# The checkout hook's settings (genomics: UV_PROJECT_ENVIRONMENT at the shared venv, UV_NO_SYNC=1), named by lane.
checkout_env=()
for key in ${LANE_CHECKOUT_ENV:-}; do
  checkout_env+=("$key=${!key-}")
done
task_prompt=$prompt
stepped=false
attempt=0
resumes=0
refusals=0
overload_waited=0
rc=0
verdict=ok
while :; do
  # Where this attempt's events start: a refusal after finished steps begins a new capacity spell.
  log_bytes=$( { wc -c <"$log"; } 2>/dev/null || echo 0)
  session_args=()
  [ -n "$session" ] && session_args=(--session "$session")
  # Without </dev/null a run blocks forever on a non-TTY stdin. --standalone starts a private server, so tools inherit
  # this scrubbed environment instead of a background service's.
  env -i HOME="$HOME" PATH="$PATH" USER="${USER:-}" LANG=en_US.UTF-8 TERM=dumb SHELL=/bin/zsh TMPDIR="$tmp/" \
    PYTHONUNBUFFERED=1 LANE_WORKER=1 UV_CACHE_DIR="$HOME/.cache/uv" ${checkout_env[@]+"${checkout_env[@]}"} \
    opencode run --standalone --auto --format json --thinking -m "$model" --title "$name" \
    ${session_args[@]+"${session_args[@]}"} "$prompt" </dev/null
  rc=$?
  read -r verdict last_session <<<"$(last_event "$rc" "$log_bytes")"
  progressed=false
  tail -c "+$((log_bytes + 1))" "$log" 2>/dev/null | grep -Fq '"type":"step_finish"' && progressed=true
  [ "$progressed" = false ] || stepped=true
  # Until a step of this run finishes, the session may never have taken the task (a refusal on the first call), so
  # a retry restates it.
  if [ "$stepped" = true ]; then
    retry_prompt=$resume_prompt
  else
    retry_prompt="$resume_prompt The task, as given:

$task_prompt"
  fi
  if [ -n "${last_session:-}" ]; then
    printf '%s\n' "$last_session" >"$session_file"
  fi
  echo "lane-opencode: attempt $attempt rc=$rc last=$verdict session=${last_session:-}"
  # A signal exit is the parent stopping the lane, never a transport fault (genomics chip-admission-v2, 2026-10-23).
  if [ "$rc" -ge 129 ] && [ "$rc" -le 159 ]; then
    break
  fi
  case ${verdict%%:*} in
    backgrounded)
      if [ "$background_resumes" -ge 2 ] || [ -z "${last_session:-}" ]; then
        echo "lane-opencode: [DEGRADED] the worker ended its turn on a background command again; the lane ends unfinished"
        break
      fi
      session=$last_session
      prompt=$background_prompt
      background_resumes=$((background_resumes + 1))
      attempt=$((attempt + 1))
      echo "lane-opencode: the turn ended on a background command; resuming the session in the foreground ($background_resumes of 2)"
      ;;
    transport | interrupted)
      refusals=0
      [ "$resumes" -lt 2 ] && [ -n "${last_session:-}" ] || break
      session=$last_session
      prompt=$retry_prompt
      resumes=$((resumes + 1))
      attempt=$((attempt + 1))
      # After a laptop sleep DNS stays down for a while: wait up to an hour for the provider instead of spending a
      # resume on the same ENOTFOUND (2026-10-22: four genomics lanes died on it).
      waited=0
      while [ -n "$host" ] && [ "$waited" -lt 3600 ] && ! curl -sS -o /dev/null --max-time 10 "https://$host/" 2>/dev/null; do
        sleep 30
        waited=$((waited + 30))
      done
      sleep "${LANE_OPENCODE_RETRY_SLEEP:-20}"
      ;;
    rate_limit)
      if [ "$progressed" = true ]; then
        # Steps finished since the last refusal, so a long lane's sporadic refusals never add up to the cap.
        refusals=0
        overload_waited=0
      fi
      refusals=$((refusals + 1))
      lower=""
      if [ "$refusals" -ge 2 ]; then
        case $model in
          lithosai/*-ultra) lower=${model%-ultra}-fast tiers="ultra→fast" ;;
          lithosai/*-fast) lower=${model%-fast} tiers="fast→base" ;;
        esac
      fi
      if [ -n "$lower" ]; then
        # The lower tier has its own capacity, so the backoff starts over.
        delay=$overload_floor
      else
        delay=$((overload_floor << (refusals < 4 ? refusals - 1 : 3)))
        asked=${verdict#rate_limit:}
        if [ "$asked" != - ] && [ "$asked" -gt "$delay" ]; then
          delay=$asked
        fi
      fi
      [ $((overload_waited + delay)) -le "$overload_cap" ] || break
      if [ -n "$lower" ]; then
        echo "lane-opencode: [DEGRADED] tier $tiers after $refusals capacity refusals in a row: $model -> $lower (same weights, served slower)"
        model=$lower
        refusals=0
      fi
      # Without a session yet the same prompt starts over; otherwise the session continues.
      if [ -n "${last_session:-}" ]; then
        session=$last_session
        prompt=$retry_prompt
      fi
      attempt=$((attempt + 1))
      echo "lane-opencode: provider at capacity or rate-limiting; retry $attempt in ${delay}s (${overload_waited}s of ${overload_cap}s waited)"
      sleep "$delay"
      overload_waited=$((overload_waited + delay))
      ;;
    *) break ;;
  esac
done
chmod -R u+w "$tmp" 2>/dev/null
rm -rf "$tmp"
usage_line
if [ "$verdict" = quota ]; then
  echo "lane-opencode: STOPPED: the provider's balance or quota is exhausted; do not retry. Top up, then lane resume."
  exit 86
fi
if [ "${verdict%%:*}" = rate_limit ] && { [ "$rc" -lt 129 ] || [ "$rc" -gt 159 ]; }; then
  echo "lane-opencode: STOPPED: the provider is still at capacity or rate-limiting after ${overload_waited}s of waiting, and" \
    "the next wait (${delay}s) would pass the ${overload_cap}s cap. lane resume continues the session."
  exit 85
fi
if [ "$verdict" = backgrounded ]; then
  # Not exit 0: lane harvests and removes a checkout whose worker exited 0, and this one is unfinished.
  echo "lane-opencode: STOPPED: the worker ended its turn on a background command after two resumes; lane resume" \
    "continues the session."
  exit 87
fi
if [ "$rc" = 0 ] && [ "${verdict%%:*}" = error ]; then
  rc=1
fi
exit "$rc"
