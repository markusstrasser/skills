#!/usr/bin/env python3
"""lane-api-spend: the OpenAI API spend of one local calendar day, priced per call with llmx's
est_cost, for lane's daily cap on codex workers billed to CODEX_API_KEY (Markus, 2026-11-04:
"let's not burn through our api credits ... maybe 50$ a day is fine").

It counts two channels. Codex rollouts (LANE_CODEX_SESSIONS, default ~/.codex/sessions): a call
billed to an API key is a token_count event with no plan window (rate_limits null), where a
ChatGPT-plan call carries the Codex window; the 664 rollouts of 2026-11-03..04 never mixed the
two in one call. llmx's own API calls: rows of LLMX_USAGE_LOG (default ~/.claude/llmx-usage.jsonl)
with provider openai over transport api. A priced call whose model has no price exits 3, since a
cap cannot hold what it cannot price; an llmx call that failed before reporting usage counts $0
and is named on stderr.

A rollout's calls cost the tier its thread settings name: on 2026-11-04 config.toml's service_tier of
ultrafast billed every API lane at 6x while this tool, then blind to tiers, reported $82.96 against
about $498 and the cap never held. An API call with a tier that has no price here also exits 3.

Usage: lane-api-spend [--day YYYY-MM-DD] [--total]
"""
import argparse
import json
import os
import shutil
import sys
from collections import defaultdict
from datetime import date, datetime, timedelta
from pathlib import Path


def llmx_interpreter() -> str:
    """The interpreter of the llmx tool on PATH, which imports llmx; LANE_LLMX_PYTHON overrides it."""
    if python := os.environ.get("LANE_LLMX_PYTHON"):
        return python
    llmx = shutil.which("llmx")
    if not llmx:
        sys.exit("lane-api-spend: llmx is not on PATH; set LANE_LLMX_PYTHON to a python that imports llmx")
    with open(llmx, "rb") as handle:
        first = handle.readline().decode(errors="replace").strip()
    if not first.startswith("#!/") or " " in first:
        sys.exit(f"lane-api-spend: {llmx} names no interpreter of its own; set LANE_LLMX_PYTHON")
    return first[2:]


try:
    from llmx.usage_report import cost_for_usage, est_cost
except ModuleNotFoundError:
    if os.environ.get("LANE_API_SPEND_REEXEC"):
        sys.exit("lane-api-spend: the llmx interpreter cannot import llmx.usage_report")
    os.environ["LANE_API_SPEND_REEXEC"] = "1"
    python = llmx_interpreter()
    os.execv(python, [python, "-I", os.path.abspath(__file__), *sys.argv[1:]])


# developers.openai.com/api/docs/models/gpt-6.1-sol, read 2026-11-05: "Batch and Flex prices are 50% lower than
# Standard", "Fast mode prices are 2x Standard", "Ultrafast mode prices are 6x Standard". Priority is not on the page.
TIER_PRICE = {"default": 1.0, "flex": 0.5, "fast": 2.0, "ultrafast": 6.0}


def local_day(stamp: str) -> date:
    return datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone().date()


def rollout_calls(path: Path):
    """(cwd, local day, model, last_token_usage, tier) of each API-billed call in one rollout. A
    token_count whose running total did not grow repeats the call before it and is skipped."""
    cwd, model, total, tier = "?", None, None, None
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            if not any(kind in line for kind in ('"session_meta"', '"turn_context"', '"token_count"', '"thread_settings_applied"')):
                continue
            try:
                record = json.loads(line)
            except ValueError:
                continue
            payload = record.get("payload")
            if not isinstance(payload, dict):
                continue
            if record.get("type") == "session_meta":
                cwd = payload.get("cwd") or cwd
            elif record.get("type") == "turn_context":
                model = payload.get("model") or model
            elif payload.get("type") == "thread_settings_applied":
                tier = (payload.get("thread_settings") or {}).get("service_tier") or tier
            elif record.get("type") == "event_msg" and payload.get("type") == "token_count":
                info = payload.get("info") or {}
                usage, running = info.get("last_token_usage"), (info.get("total_token_usage") or {}).get("total_tokens")
                if not usage or running == total:
                    continue
                total = running
                if payload.get("rate_limits") is None:
                    yield cwd, local_day(record["timestamp"]), model, usage, tier


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--day", type=date.fromisoformat, default=date.today(), help="local day (default today)")
    parser.add_argument("--total", action="store_true", help="print only the day's total in dollars")
    args = parser.parse_args()
    cost, calls, unpriced, failed = defaultdict(float), defaultdict(int), defaultdict(int), defaultdict(int)

    sessions = Path(os.environ.get("LANE_CODEX_SESSIONS") or Path.home() / ".codex/sessions")
    start = datetime.combine(args.day, datetime.min.time()).timestamp()
    # A session files its rollout under the local day it started, so one started yesterday can bill today;
    # one not written since the day began cannot.
    for folder in (sessions / f"{day:%Y/%m/%d}" for day in (args.day - timedelta(days=1), args.day)):
        for rollout in sorted(folder.glob("rollout-*.jsonl")) if folder.is_dir() else ():
            if rollout.stat().st_mtime < start:
                continue
            for cwd, day, model, usage, tier in rollout_calls(rollout):
                if day != args.day:
                    continue
                label = f"codex {Path(cwd).name}"
                price = est_cost(model or "", usage.get("input_tokens", 0), usage.get("output_tokens", 0),
                                 cached_tokens=usage.get("cached_input_tokens", 0),
                                 cache_write_tokens=usage.get("cache_write_input_tokens", 0))
                if price is None or tier not in TIER_PRICE:
                    unpriced[f"{model} at tier {tier} ({label})"] += 1
                    continue
                cost[label] += price * TIER_PRICE[tier]
                calls[label] += 1

    log = Path(os.environ.get("LLMX_USAGE_LOG") or Path.home() / ".claude/llmx-usage.jsonl")
    for line in log.open(encoding="utf-8", errors="replace") if log.is_file() else ():
        if '"openai"' not in line:
            continue
        try:
            row = json.loads(line)
            if row.get("provider") != "openai" or row.get("transport") != "api" or local_day(row["ts"]) != args.day:
                continue
        except (ValueError, KeyError, TypeError):
            continue
        label = f"llmx {row.get('caller') or row.get('source') or '-'}"
        price = cost_for_usage(row)
        if price is None and row.get("prompt_tokens") is None:
            failed[label] += 1
            continue
        if price is None:
            unpriced[f"{row.get('model')} ({label})"] += 1
            continue
        cost[label] += price
        calls[label] += 1

    for label, n in sorted(failed.items()):
        print(f"lane-api-spend: [DEGRADED] {n} llmx API call(s) of {label} reported no usage; counted $0",
              file=sys.stderr)
    if unpriced:
        names = ", ".join(f"{name}: {n}" for name, n in sorted(unpriced.items()))
        print(f"lane-api-spend: no llmx price for API calls on {args.day} ({names})", file=sys.stderr)
        return 3
    spent = sum(cost.values())
    if args.total:
        print(f"{spent:.2f}")
        return 0
    for label, dollars in sorted(cost.items(), key=lambda item: -item[1]):
        print(f"${dollars:7.2f} {calls[label]:5d} calls  {label}")
    print(f"total {args.day} ${spent:.2f} in {sum(calls.values())} calls")
    return 0


if __name__ == "__main__":
    sys.exit(main())
